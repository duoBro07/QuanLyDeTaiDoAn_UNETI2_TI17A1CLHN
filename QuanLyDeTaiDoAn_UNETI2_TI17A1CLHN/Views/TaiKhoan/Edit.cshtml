@model QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.ViewModels.TaiKhoan.TaiKhoanEditViewModel
@{ ViewData["Title"] = "Sửa tài khoản"; }
<div class="form-page-wrap">
<div class="page-card form-card">
    <div class="page-card-header"><div><h4>Sửa thông tin tài khoản</h4><small class="text-secondary">Để trống mật khẩu mới nếu không muốn đổi mật khẩu</small></div></div>
    <div class="page-card-body">
        <form asp-action="Edit" asp-route-id="@Model.MaTaiKhoan" method="post">
            <input type="hidden" asp-for="MaTaiKhoan" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="form-grid">
                <div><label asp-for="TenDangNhap" class="form-label"></label><input asp-for="TenDangNhap" class="form-control" /><span asp-validation-for="TenDangNhap" class="text-danger"></span></div>
                <div><label asp-for="HoTen" class="form-label"></label><input asp-for="HoTen" class="form-control" /><span asp-validation-for="HoTen" class="text-danger"></span></div>
                <div><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
                <div><label asp-for="VaiTro" class="form-label"></label><select asp-for="VaiTro" class="form-select"><option value="SinhVien">Sinh viên</option><option value="Admin">Admin</option></select><span asp-validation-for="VaiTro" class="text-danger"></span></div>
                <div><label asp-for="MatKhauMoi" class="form-label"></label><input asp-for="MatKhauMoi" class="form-control" placeholder="Không đổi thì để trống" /><span asp-validation-for="MatKhauMoi" class="text-danger"></span></div>
                <div><label asp-for="XacNhanMatKhauMoi" class="form-label"></label><input asp-for="XacNhanMatKhauMoi" class="form-control" /><span asp-validation-for="XacNhanMatKhauMoi" class="text-danger"></span></div>
            </div>
            <div class="form-check my-4"><input asp-for="TrangThai" class="form-check-input" /><label asp-for="TrangThai" class="form-check-label">Tài khoản hoạt động</label><span asp-validation-for="TrangThai" class="text-danger d-block"></span></div>
            <div class="d-flex gap-2"><a asp-action="Index" class="btn-soft">Hủy</a><button type="submit" class="btn-main">Lưu thay đổi</button></div>
        </form>
    </div>
</div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
