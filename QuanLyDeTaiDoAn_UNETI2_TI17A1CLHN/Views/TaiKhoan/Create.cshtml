@model QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.ViewModels.TaiKhoan.TaiKhoanCreateViewModel
@{ ViewData["Title"] = "Thêm tài khoản"; }
<div class="form-page-wrap">
<div class="page-card form-card">
    <div class="page-card-header"><div><h4>Thêm tài khoản mới</h4><small class="text-secondary">Tên đăng nhập phải duy nhất trong hệ thống</small></div></div>
    <div class="page-card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="form-grid">
                <div><label asp-for="TenDangNhap" class="form-label"></label><input asp-for="TenDangNhap" class="form-control" /><span asp-validation-for="TenDangNhap" class="text-danger"></span></div>
                <div><label asp-for="HoTen" class="form-label"></label><input asp-for="HoTen" class="form-control" /><span asp-validation-for="HoTen" class="text-danger"></span></div>
                <div><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
                <div><label asp-for="VaiTro" class="form-label"></label><select asp-for="VaiTro" class="form-select"><option value="SinhVien">Sinh viên</option><option value="Admin">Admin</option></select><span asp-validation-for="VaiTro" class="text-danger"></span></div>
                <div><label asp-for="MatKhau" class="form-label"></label><input asp-for="MatKhau" class="form-control" /><span asp-validation-for="MatKhau" class="text-danger"></span></div>
                <div><label asp-for="XacNhanMatKhau" class="form-label"></label><input asp-for="XacNhanMatKhau" class="form-control" /><span asp-validation-for="XacNhanMatKhau" class="text-danger"></span></div>
            </div>
            <div class="form-check my-4"><input asp-for="TrangThai" class="form-check-input" /><label asp-for="TrangThai" class="form-check-label">Cho phép đăng nhập ngay</label></div>
            <div class="d-flex gap-2"><a asp-action="Index" class="btn-soft">Hủy</a><button type="submit" class="btn-main">Lưu tài khoản</button></div>
        </form>
    </div>
</div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
