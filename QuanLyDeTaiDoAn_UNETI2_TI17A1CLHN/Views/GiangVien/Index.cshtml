@model IEnumerable<QuanLyDeTaiDoAn.Models.GiangVien>

@{
    ViewData["Title"] = "Quản lý giảng viên";

    int trangHienTai = ViewBag.TrangHienTai ?? 1;
    int tongTrang = ViewBag.TongTrang ?? 0;
    int tongBanGhi = ViewBag.TongBanGhi ?? 0;
    int kichThuocTrang = ViewBag.KichThuocTrang ?? 5;

    int batDau = tongBanGhi == 0
        ? 0
        : (trangHienTai - 1) * kichThuocTrang + 1;

    int ketThuc = Math.Min(
        trangHienTai * kichThuocTrang,
        tongBanGhi);
}

<div class="content-card">


    <div class="p-3">

        <div class="d-flex justify-content-between
            align-items-center mb-3">

            <h2 class="page-title">
                Quản lý giảng viên
            </h2>

            <a asp-action="Create"
               class="btn btn-main">

                <i class="fa-solid fa-plus me-1"></i>
                Thêm giảng viên

            </a>

        </div>

        <form asp-action="Index"
              method="get">

            <div class="row g-2">

                <div class="col-lg-6">

                    <div class="input-group">

                        <span class="input-group-text bg-white">
                            <i class="fa-solid fa-magnifying-glass
                            text-secondary"></i>
                        </span>

                        <input type="text"
                               name="tuKhoa"
                               value="@ViewBag.TuKhoa"
                               class="form-control"
                               placeholder="Tìm kiếm theo tên, email, số điện thoại..." />

                    </div>

                </div>

                <div class="col-lg-3">

                    <select name="maLinhVuc"
                            class="form-select"
                            onchange="this.form.submit()">

                        <option value="">
                            Tất cả lĩnh vực
                        </option>

                        @foreach (var lv in ViewBag.LinhVucs)
                        {
                            if (ViewBag.MaLinhVucLoc != null &&
                                (int)ViewBag.MaLinhVucLoc == lv.MaLinhVuc)
                            {
                                <option value="@lv.MaLinhVuc" selected>
                                    @lv.TenLinhVuc
                                </option>
                            }
                            else
                            {
                                <option value="@lv.MaLinhVuc">
                                    @lv.TenLinhVuc
                                </option>
                            }
                        }

                    </select>

                </div>

                <div class="col-lg-3">

                    <select name="trangThai"
                            class="form-select"
                            onchange="this.form.submit()">

                        <option value="">
                            Tất cả trạng thái
                        </option>

                        @if (ViewBag.TrangThaiLoc == "Đang công tác")
                        {
                            <option value="Đang công tác" selected>
                                Đang công tác
                            </option>
                        }
                        else
                        {
                            <option value="Đang công tác">
                                Đang công tác
                            </option>
                        }

                        @if (ViewBag.TrangThaiLoc == "Tạm ngừng hướng dẫn")
                        {
                            <option value="Tạm ngừng hướng dẫn" selected>
                                Tạm ngừng hướng dẫn
                            </option>
                        }
                        else
                        {
                            <option value="Tạm ngừng hướng dẫn">
                                Tạm ngừng hướng dẫn
                            </option>
                        }

                    </select>

                </div>

            </div>

     
            <button type="submit"
                    style="display:none">
            </button>

        </form>

    </div>


    <div class="table-responsive">

        <table class="table table-hover mb-0">

            <thead>
                <tr>
                    <th class="ps-3">STT</th>
                    <th>Họ tên</th>
                    <th>Học vị</th>
                    <th>Email</th>
                    <th>SĐT</th>
                    <th>Lĩnh vực</th>
                    <th class="text-center">Số SV tối đa</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Any())
                {
                    int stt = batDau;

                    foreach (var item in Model)
                    {
                        <tr>

                            <td class="ps-3">
                                @stt
                            </td>

                            <td class="fw-semibold">
                                @item.HoTen
                            </td>

                            <td>
                                @item.HocVi
                            </td>

                            <td>
                                @item.Email
                            </td>

                            <td>
                                @item.SoDienThoai
                            </td>

                            <td>
                                @item.LinhVuc?.TenLinhVuc
                            </td>

                            <td class="text-center">
                                @item.SoSinhVienHuongDanToiDa
                            </td>

                            <td>

                                @if (item.TrangThai == "Đang công tác")
                                {
                                    <span class="status-active">
                                        Đang công tác
                                    </span>
                                }
                                else
                                {
                                    <span class="status-stop">
                                        Tạm ngừng
                                    </span>
                                }

                            </td>

                            <td class="text-center text-nowrap">

                                <a asp-action="Edit"
                                   asp-route-id="@item.MaGiangVien"
                                   class="action-btn action-edit"
                                   title="Sửa">

                                    <i class="fa-solid fa-pen-to-square"></i>

                                </a>

                                <a asp-action="Details"
                                   asp-route-id="@item.MaGiangVien"
                                   class="action-btn action-info"
                                   title="Chi tiết">

                                    <i class="fa-solid fa-circle-info"></i>

                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.MaGiangVien"
                                   class="action-btn action-delete"
                                   title="Xóa">

                                    <i class="fa-solid fa-trash"></i>

                                </a>

                            </td>

                        </tr>

                        stt++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9"
                            class="text-center text-muted py-5">

                            Chưa có dữ liệu giảng viên.

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>


    <div class="d-flex justify-content-between
        align-items-center p-3 border-top">

        <nav>

            @if (tongTrang > 0)
            {
                <ul class="pagination pagination-sm mb-0">

                    <li class="page-item
                        @(trangHienTai <= 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-trang="@(trangHienTai - 1)"
                           asp-route-tuKhoa="@ViewBag.TuKhoa"
                           asp-route-maLinhVuc="@ViewBag.MaLinhVucLoc"
                           asp-route-trangThai="@ViewBag.TrangThaiLoc">
                            ‹
                        </a>

                    </li>

                    @for (int i = 1; i <= tongTrang; i++)
                    {
                        <li class="page-item
                            @(i == trangHienTai ? "active" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-trang="@i"
                               asp-route-tuKhoa="@ViewBag.TuKhoa"
                               asp-route-maLinhVuc="@ViewBag.MaLinhVucLoc"
                               asp-route-trangThai="@ViewBag.TrangThaiLoc">

                                @i

                            </a>

                        </li>
                    }

                    <li class="page-item
                        @(trangHienTai >= tongTrang ? "disabled" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-trang="@(trangHienTai + 1)"
                           asp-route-tuKhoa="@ViewBag.TuKhoa"
                           asp-route-maLinhVuc="@ViewBag.MaLinhVucLoc"
                           asp-route-trangThai="@ViewBag.TrangThaiLoc">
                            ›
                        </a>

                    </li>

                </ul>
            }

        </nav>

        <small class="text-muted">

            Hiển thị @batDau - @ketThuc
            trong @tongBanGhi kết quả

        </small>

    </div>

</div>