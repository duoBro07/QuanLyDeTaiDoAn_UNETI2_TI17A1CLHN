@model IEnumerable<QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models.GiangVien>

@{
    ViewData["Title"] = "Quản lý giảng viên";

    int trangHienTai = ViewBag.TrangHienTai ?? 1;
    int tongTrang = ViewBag.TongTrang ?? 0;
    int tongBanGhi = ViewBag.TongBanGhi ?? 0;
    int kichThuocTrang = ViewBag.KichThuocTrang ?? 5;

    int batDau = tongBanGhi == 0
        ? 0
        : (trangHienTai - 1) * kichThuocTrang + 1;

    int ketThuc = Math.Min(
        trangHienTai * kichThuocTrang,
        tongBanGhi);

    string? thongBao = TempData["ThongBaoGiangVien"] as string;
    string? loi = TempData["LoiGiangVien"] as string;
}

<div class="content-card">

    <div class="p-3">

        @* TIÊU ĐỀ VÀ NÚT THÊM GIẢNG VIÊN *@

        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>
                <h2 class="page-title mb-1">
                    Quản lý giảng viên
                </h2>

                <small class="text-muted">
                    Danh sách giảng viên hướng dẫn đồ án
                </small>
            </div>

            <a asp-controller="GiangVien"
               asp-action="Create"
               class="btn btn-main">

                <i class="fa-solid fa-plus me-1"></i>
                Thêm giảng viên

            </a>

        </div>

        @* THÔNG BÁO THÊM / SỬA / CẬP NHẬT THÀNH CÔNG *@

        @if (!string.IsNullOrWhiteSpace(thongBao))
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">

                <i class="fa-solid fa-circle-check me-2"></i>

                <strong>Thành công!</strong>
                @thongBao

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Đóng">
                </button>

            </div>
        }

        @* THÔNG BÁO LỖI *@

        @if (!string.IsNullOrWhiteSpace(loi))
        {
            <div class="alert alert-danger alert-dismissible fade show"
                 role="alert">

                <i class="fa-solid fa-circle-exclamation me-2"></i>

                <strong>Lỗi!</strong>
                @loi

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Đóng">
                </button>

            </div>
        }

        @* FORM TÌM KIẾM VÀ LỌC GIẢNG VIÊN *@

        <form asp-controller="GiangVien"
              asp-action="Index"
              method="get">

            <div class="row g-2">

                @* TÌM KIẾM *@

                <div class="col-lg-6">

                    <div class="input-group">

                        <span class="input-group-text bg-white">
                            <i class="fa-solid fa-magnifying-glass text-secondary"></i>
                        </span>

                        <input type="text"
                               name="tuKhoa"
                               value="@ViewBag.TuKhoa"
                               class="form-control"
                               placeholder="Tìm kiếm theo tên, email, số điện thoại..." />

                    </div>

                </div>

                @* LỌC THEO LĨNH VỰC *@

                <div class="col-lg-3">

                    <select name="maLinhVuc"
                            class="form-select"
                            onchange="this.form.submit()">

                        <option value="">
                            Tất cả lĩnh vực
                        </option>

                        @if (ViewBag.LinhVucs != null)
                        {
                            foreach (var lv in ViewBag.LinhVucs)
                            {
                                if (ViewBag.MaLinhVucLoc != null &&
                                    (int)ViewBag.MaLinhVucLoc == lv.MaLinhVuc)
                                {
                                    <option value="@lv.MaLinhVuc" selected>
                                        @lv.TenLinhVuc
                                    </option>
                                }
                                else
                                {
                                    <option value="@lv.MaLinhVuc">
                                        @lv.TenLinhVuc
                                    </option>
                                }
                            }
                        }

                    </select>

                </div>

                @* LỌC THEO TRẠNG THÁI *@

                <div class="col-lg-3">

                    <select name="trangThai"
                            class="form-select"
                            onchange="this.form.submit()">

                        <option value="">
                            Tất cả trạng thái
                        </option>

                        @if (ViewBag.TrangThaiLoc == "Đang công tác")
                        {
                            <option value="Đang công tác" selected>
                                Đang công tác
                            </option>
                        }
                        else
                        {
                            <option value="Đang công tác">
                                Đang công tác
                            </option>
                        }

                        @if (ViewBag.TrangThaiLoc == "Tạm ngừng hướng dẫn")
                        {
                            <option value="Tạm ngừng hướng dẫn" selected>
                                Tạm ngừng hướng dẫn
                            </option>
                        }
                        else
                        {
                            <option value="Tạm ngừng hướng dẫn">
                                Tạm ngừng hướng dẫn
                            </option>
                        }

                    </select>

                </div>

            </div>

            <button type="submit" style="display:none"></button>

        </form>

    </div>

    @* BẢNG DANH SÁCH GIẢNG VIÊN *@

    <div class="table-responsive">

        <table class="table table-hover mb-0">

            <thead>
                <tr>
                    <th class="ps-3">STT</th>
                    <th>Họ tên</th>
                    <th>Học vị</th>
                    <th>Email</th>
                    <th>SĐT</th>
                    <th>Lĩnh vực</th>
                    <th class="text-center">Số SV tối đa</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    int stt = batDau;

                    foreach (var item in Model)
                    {
                        <tr>

                            <td class="ps-3">
                                @stt
                            </td>

                            <td class="fw-semibold">
                                @item.HoTen
                            </td>

                            <td>
                                @item.HocVi
                            </td>

                            <td>
                                @item.Email
                            </td>

                            <td>
                                @item.SoDienThoai
                            </td>

                            <td>
                                @(item.LinhVuc?.TenLinhVuc ?? "Chưa xác định")
                            </td>

                            <td class="text-center">
                                @item.SoSinhVienHuongDanToiDa
                            </td>

                            <td>

                                @if (item.TrangThai == "Đang công tác")
                                {
                                    <span class="status-active">
                                        Đang công tác
                                    </span>
                                }
                                else
                                {
                                    <span class="status-stop">
                                        Tạm ngừng
                                    </span>
                                }

                            </td>

                            <td class="text-center text-nowrap">

                                @* NÚT SỬA *@

                                <a asp-controller="GiangVien"
                                   asp-action="Edit"
                                   asp-route-id="@item.MaGiangVien"
                                   class="action-btn action-edit"
                                   title="Sửa giảng viên">

                                    <i class="fa-solid fa-pen-to-square"></i>

                                </a>

                                @* NÚT CHI TIẾT *@

                                <a asp-controller="GiangVien"
                                   asp-action="Details"
                                   asp-route-id="@item.MaGiangVien"
                                   class="action-btn action-info"
                                   title="Chi tiết giảng viên">

                                    <i class="fa-solid fa-circle-info"></i>

                                </a>

                                @* NÚT XÓA / TẠM NGỪNG *@

                                <a asp-controller="GiangVien"
                                   asp-action="Delete"
                                   asp-route-id="@item.MaGiangVien"
                                   class="action-btn action-delete"
                                   title="Tạm ngừng hướng dẫn">

                                    <i class="fa-solid fa-trash"></i>

                                </a>

                            </td>

                        </tr>

                        stt++;
                    }
                }
                else
                {
                    <tr>

                        <td colspan="9"
                            class="text-center text-muted py-5">

                            <i class="fa-solid fa-users fa-2x mb-3 d-block"></i>

                            Không tìm thấy dữ liệu giảng viên.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

    @* PHÂN TRANG *@

    <div class="d-flex justify-content-between align-items-center p-3 border-top flex-wrap gap-2">

        <nav>

            @if (tongTrang > 0)
            {
                <ul class="pagination pagination-sm mb-0">

                    @* TRANG TRƯỚC *@

                    <li class="page-item @(trangHienTai <= 1 ? "disabled" : "")">

                        <a class="page-link"
                           asp-controller="GiangVien"
                           asp-action="Index"
                           asp-route-trang="@(trangHienTai - 1)"
                           asp-route-tuKhoa="@ViewBag.TuKhoa"
                           asp-route-maLinhVuc="@ViewBag.MaLinhVucLoc"
                           asp-route-trangThai="@ViewBag.TrangThaiLoc">

                            ‹

                        </a>

                    </li>

                    @* DANH SÁCH SỐ TRANG *@

                    @for (int i = 1; i <= tongTrang; i++)
                    {
                        <li class="page-item @(i == trangHienTai ? "active" : "")">

                            <a class="page-link"
                               asp-controller="GiangVien"
                               asp-action="Index"
                               asp-route-trang="@i"
                               asp-route-tuKhoa="@ViewBag.TuKhoa"
                               asp-route-maLinhVuc="@ViewBag.MaLinhVucLoc"
                               asp-route-trangThai="@ViewBag.TrangThaiLoc">

                                @i

                            </a>

                        </li>
                    }

                    @* TRANG TIẾP THEO *@

                    <li class="page-item @(trangHienTai >= tongTrang ? "disabled" : "")">

                        <a class="page-link"
                           asp-controller="GiangVien"
                           asp-action="Index"
                           asp-route-trang="@(trangHienTai + 1)"
                           asp-route-tuKhoa="@ViewBag.TuKhoa"
                           asp-route-maLinhVuc="@ViewBag.MaLinhVucLoc"
                           asp-route-trangThai="@ViewBag.TrangThaiLoc">

                            ›

                        </a>

                    </li>

                </ul>
            }

        </nav>

        <small class="text-muted">

            Hiển thị @batDau - @ketThuc
            trong @tongBanGhi kết quả

        </small>

    </div>

</div>
