@model IEnumerable<QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models.GiangVien>
@using QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models

@{
    ViewData["Title"] = "Quản lý giảng viên";
    ViewData["UnifiedIndex"] = true;

    int trang = ViewBag.TrangHienTai ?? 1;
    int tongTrang = ViewBag.TongTrang ?? 1;
    int tong = ViewBag.TongBanGhi ?? 0;
    int kichThuoc = ViewBag.KichThuocTrang ?? 5;

    string tuKhoa = ViewBag.TuKhoa ?? "";
    int? maLinhVuc = ViewBag.MaLinhVucLoc;
    string trangThai = ViewBag.TrangThaiLoc ?? "";

    var linhVucs = ViewBag.LinhVucs as IEnumerable<LinhVuc>
        ?? Enumerable.Empty<LinhVuc>();

    int batDau = tong == 0 ? 0 : (trang - 1) * kichThuoc + 1;
    int ketThuc = Math.Min(trang * kichThuoc, tong);
}

<div class="content-card">
    <div class="p-3 p-lg-4">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h2 class="page-title mb-1">
                    <i class="fa-solid fa-chalkboard-user me-2"></i>
                    Quản lý giảng viên
                </h2>
                <p class="page-description mb-0">
                    Quản lý hồ sơ, lĩnh vực và khả năng hướng dẫn của giảng viên
                </p>
            </div>

            <a asp-controller="GiangVien"
               asp-action="Create"
               class="btn btn-main">
                <i class="fa-solid fa-plus"></i>
                Thêm giảng viên
            </a>
        </div>

        @if (TempData["ThongBaoGiangVien"] != null)
        {
            <div class="alert alert-success">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["ThongBaoGiangVien"]
            </div>
        }

        @if (TempData["LoiGiangVien"] != null)
        {
            <div class="alert alert-danger">
                <i class="fa-solid fa-circle-exclamation me-2"></i>
                @TempData["LoiGiangVien"]
            </div>
        }

        <form asp-controller="GiangVien"
              asp-action="Index"
              method="get"
              class="uneti-filter-bar">

            <div class="row g-3">

                <div class="col-lg-4">
                    <label for="tuKhoa" class="form-label">
                        <i class="fa-solid fa-magnifying-glass me-1"></i>
                        Tìm kiếm
                    </label>

                    <input id="tuKhoa"
                           name="tuKhoa"
                           value="@tuKhoa"
                           class="form-control"
                           placeholder="Họ tên, email, số điện thoại..." />
                </div>

                <div class="col-lg-3">
                    <label for="maLinhVuc" class="form-label">
                        <i class="fa-solid fa-layer-group me-1"></i>
                        Lĩnh vực
                    </label>

                    <select id="maLinhVuc"
                            name="maLinhVuc"
                            class="form-select">

                        <option value="">Tất cả lĩnh vực</option>

                        @foreach (var lv in linhVucs)
                        {
                            <option value="@lv.MaLinhVuc"
                                    selected="@(maLinhVuc == lv.MaLinhVuc)">
                                @lv.TenLinhVuc
                            </option>
                        }
                    </select>
                </div>

                <div class="col-lg-2">
                    <label for="trangThai" class="form-label">
                        <i class="fa-solid fa-filter me-1"></i>
                        Trạng thái
                    </label>

                    <select id="trangThai"
                            name="trangThai"
                            class="form-select">

                        <option value="">Tất cả</option>

                        <option value="Đang công tác"
                                selected="@(trangThai == "Đang công tác")">
                            Đang công tác
                        </option>

                        <option value="Tạm ngừng hướng dẫn"
                                selected="@(trangThai == "Tạm ngừng hướng dẫn")">
                            Tạm ngừng hướng dẫn
                        </option>
                    </select>
                </div>

                <div class="col-lg-3 d-flex align-items-end gap-2">
                    <button type="submit"
                            class="btn btn-main flex-fill">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        Tìm kiếm
                    </button>

                    <a asp-controller="GiangVien"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        <i class="fa-solid fa-rotate-left"></i>
                        Đặt lại
                    </a>
                </div>

            </div>
        </form>

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h5 class="fw-bold mb-0" style="color:#17477e">
                <i class="fa-solid fa-list me-2"></i>
                Danh sách giảng viên (@tong)
            </h5>

            <span class="text-muted small">
                @kichThuoc bản ghi / trang
            </span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table uneti-table table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-3">STT</th>
                    <th>Mã GV</th>
                    <th>Họ và tên</th>
                    <th>Học vị</th>
                    <th>Email</th>
                    <th>Số điện thoại</th>
                    <th>Lĩnh vực</th>
                    <th class="text-center">SV tối đa</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    int stt = batDau;

                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3">@stt</td>
                            <td>@item.MaGiangVien</td>

                            <td class="fw-semibold">
                                @item.HoTen
                            </td>

                            <td>@item.HocVi</td>
                            <td>@item.Email</td>
                            <td>@(item.SoDienThoai ?? "—")</td>
                            <td>@(item.LinhVuc?.TenLinhVuc ?? "Chưa có")</td>

                            <td class="text-center">
                                @item.SoSinhVienHuongDanToiDa
                            </td>

                            <td class="text-center">
                                @if (item.TrangThai == "Đang công tác")
                                {
                                    <span class="uneti-status uneti-status-success">
                                        <i class="fa-solid fa-circle-check me-1"></i>
                                        Đang công tác
                                    </span>
                                }
                                else
                                {
                                    <span class="uneti-status uneti-status-warning">
                                        <i class="fa-solid fa-circle-pause me-1"></i>
                                        @item.TrangThai
                                    </span>
                                }
                            </td>

                            <td class="text-center">
                                <div class="uneti-actions">

                                    <a asp-controller="GiangVien"
                                       asp-action="Details"
                                       asp-route-id="@item.MaGiangVien"
                                       class="btn btn-outline-primary btn-sm"
                                       title="Xem chi tiết"
                                       aria-label="Xem giảng viên @item.HoTen">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>

                                    <a asp-controller="GiangVien"
                                       asp-action="Edit"
                                       asp-route-id="@item.MaGiangVien"
                                       class="btn btn-outline-primary btn-sm"
                                       title="Chỉnh sửa"
                                       aria-label="Sửa giảng viên @item.HoTen">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>

                                    <a asp-controller="GiangVien"
                                       asp-action="Delete"
                                       asp-route-id="@item.MaGiangVien"
                                       class="btn btn-outline-danger btn-sm"
                                       title="Tạm ngừng hướng dẫn"
                                       aria-label="Tạm ngừng giảng viên @item.HoTen">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>

                                </div>
                            </td>
                        </tr>

                        stt++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-5">
                            <i class="fa-solid fa-inbox fa-2x d-block mb-3"></i>
                            Không tìm thấy giảng viên phù hợp.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-3 border-top">

        <div class="uneti-pagination-info">
            Hiển thị <strong>@batDau - @ketThuc</strong>
            trong tổng số <strong>@tong</strong> giảng viên
        </div>

        @if (tongTrang > 1)
        {
            <nav aria-label="Phân trang giảng viên">
                <ul class="pagination pagination-sm mb-0">

                    <li class="page-item @(trang <= 1 ? "disabled" : "")">
                        @if (trang > 1)
                        {
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-trang="@(trang - 1)"
                               asp-route-tuKhoa="@tuKhoa"
                               asp-route-maLinhVuc="@maLinhVuc"
                               asp-route-trangThai="@trangThai">
                                <i class="fa-solid fa-chevron-left"></i>
                                Trước
                            </a>
                        }
                        else
                        {
                            <span class="page-link">Trước</span>
                        }
                    </li>

                    @for (int i = 1; i <= tongTrang; i++)
                    {
                        <li class="page-item @(i == trang ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-trang="@i"
                               asp-route-tuKhoa="@tuKhoa"
                               asp-route-maLinhVuc="@maLinhVuc"
                               asp-route-trangThai="@trangThai">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(trang >= tongTrang ? "disabled" : "")">
                        @if (trang < tongTrang)
                        {
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-trang="@(trang + 1)"
                               asp-route-tuKhoa="@tuKhoa"
                               asp-route-maLinhVuc="@maLinhVuc"
                               asp-route-trangThai="@trangThai">
                                Sau
                                <i class="fa-solid fa-chevron-right"></i>
                            </a>
                        }
                        else
                        {
                            <span class="page-link">Sau</span>
                        }
                    </li>

                </ul>
            </nav>
        }
    </div>
</div>
