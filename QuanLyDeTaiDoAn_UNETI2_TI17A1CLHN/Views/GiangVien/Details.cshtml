@model QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models.GiangVien

@{
    ViewData["Title"] = "Chi tiết giảng viên";
}

<div class="content-card">
    <div class="p-3 p-lg-4">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h2 class="page-title mb-1">
                    <i class="fa-solid fa-eye me-2"></i>
                    Chi tiết giảng viên
                </h2>
                <p class="page-description mb-0">
                    Thông tin hồ sơ giảng viên hướng dẫn
                </p>
            </div>

            @if (Model.TrangThai == "Đang công tác")
            {
                <span class="uneti-status uneti-status-success">
                    <i class="fa-solid fa-circle-check me-1"></i>
                    Đang công tác
                </span>
            }
            else
            {
                <span class="uneti-status uneti-status-warning">
                    <i class="fa-solid fa-circle-pause me-1"></i>
                    @Model.TrangThai
                </span>
            }
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Mã giảng viên</div>
            <div class="uneti-details-value">@Model.MaGiangVien</div>
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Họ và tên</div>
            <div class="uneti-details-value fw-semibold">@Model.HoTen</div>
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Học vị</div>
            <div class="uneti-details-value">@Model.HocVi</div>
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Email</div>
            <div class="uneti-details-value">@Model.Email</div>
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Số điện thoại</div>
            <div class="uneti-details-value">
                @(string.IsNullOrWhiteSpace(Model.SoDienThoai)
                    ? "Chưa cập nhật" : Model.SoDienThoai)
            </div>
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Lĩnh vực</div>
            <div class="uneti-details-value">
                @(Model.LinhVuc?.TenLinhVuc ?? "Chưa có")
            </div>
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">
                Số sinh viên hướng dẫn tối đa
            </div>
            <div class="uneti-details-value">
                @Model.SoSinhVienHuongDanToiDa
            </div>
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Trạng thái</div>
            <div class="uneti-details-value">@Model.TrangThai</div>
        </div>

        <hr class="my-4" />

        <div class="d-flex justify-content-end gap-2 flex-wrap">
            <a asp-controller="GiangVien"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left"></i>
                Quay lại
            </a>

            <a asp-controller="GiangVien"
               asp-action="Edit"
               asp-route-id="@Model.MaGiangVien"
               class="btn btn-main">
                <i class="fa-solid fa-pen"></i>
                Chỉnh sửa
            </a>
        </div>

    </div>
</div>
