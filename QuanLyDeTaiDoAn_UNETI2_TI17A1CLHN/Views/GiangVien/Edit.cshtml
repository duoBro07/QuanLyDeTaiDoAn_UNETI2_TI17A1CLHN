@model QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models.GiangVien

@{
    ViewData["Title"] = "Chỉnh sửa giảng viên";
}

<div class="content-card">
    <div class="p-3 p-lg-4">

        <div class="mb-4">
            <h2 class="page-title mb-1">
                <i class="fa-solid fa-pen me-2"></i>
                Chỉnh sửa giảng viên
            </h2>
            <p class="page-description mb-0">
                Cập nhật thông tin giảng viên hướng dẫn
            </p>
        </div>

        <form id="formSuaGiangVien"
              asp-controller="GiangVien"
              asp-action="Edit"
              asp-route-id="@Model.MaGiangVien"
              method="post">

            @Html.AntiForgeryToken()
            <input asp-for="MaGiangVien" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row g-3">

                <div class="col-md-4">
                    <label class="form-label">Mã giảng viên</label>
                    <input class="form-control"
                           value="@Model.MaGiangVien"
                           readonly />
                </div>

                <div class="col-md-8">
                    <label asp-for="HoTen" class="form-label">
                        Họ và tên <span class="text-danger">*</span>
                    </label>
                    <input asp-for="HoTen" class="form-control" />
                    <span asp-validation-for="HoTen" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="HocVi" class="form-label">
                        Học vị <span class="text-danger">*</span>
                    </label>
                    <input asp-for="HocVi" class="form-control" />
                    <span asp-validation-for="HocVi" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">
                        Email <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Email"
                           type="email"
                           class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SoDienThoai" class="form-label">
                        Số điện thoại
                    </label>
                    <input asp-for="SoDienThoai"
                           type="tel"
                           class="form-control" />
                    <span asp-validation-for="SoDienThoai"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MaLinhVuc" class="form-label">
                        Lĩnh vực <span class="text-danger">*</span>
                    </label>
                    <select asp-for="MaLinhVuc"
                            asp-items="ViewBag.MaLinhVuc"
                            class="form-select">
                        <option value="0">-- Chọn lĩnh vực --</option>
                    </select>
                    <span asp-validation-for="MaLinhVuc"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SoSinhVienHuongDanToiDa"
                           class="form-label">
                        Số sinh viên hướng dẫn tối đa
                        <span class="text-danger">*</span>
                    </label>
                    <input asp-for="SoSinhVienHuongDanToiDa"
                           type="number"
                           min="1"
                           class="form-control" />
                    <span asp-validation-for="SoSinhVienHuongDanToiDa"
                          class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label class="form-label d-block">
                        Trạng thái
                    </label>

                    <div class="form-check form-check-inline">
                        <input asp-for="TrangThai"
                               type="radio"
                               value="Đang công tác"
                               id="editDangCongTac"
                               class="form-check-input" />
                        <label for="editDangCongTac"
                               class="form-check-label">
                            Đang công tác
                        </label>
                    </div>

                    <div class="form-check form-check-inline">
                        <input asp-for="TrangThai"
                               type="radio"
                               value="Tạm ngừng hướng dẫn"
                               id="editTamNgung"
                               class="form-check-input" />
                        <label for="editTamNgung"
                               class="form-check-label">
                            Tạm ngừng hướng dẫn
                        </label>
                    </div>

                    <span asp-validation-for="TrangThai"
                          class="text-danger d-block"></span>
                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2 flex-wrap">
                <a asp-controller="GiangVien"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left"></i>
                    Quay lại
                </a>

                <button type="button"
                        class="btn btn-main"
                        id="btnMoXacNhanSua">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Cập nhật giảng viên
                </button>
            </div>

        </form>
    </div>
</div>

<div class="modal fade"
     id="modalXacNhanSua"
     tabindex="-1"
     aria-labelledby="tieuDeXacNhanSua"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="tieuDeXacNhanSua">
                    <i class="fa-solid fa-circle-question me-2"></i>
                    Xác nhận cập nhật
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Đóng"></button>
            </div>

            <div class="modal-body">
                Bạn có chắc chắn muốn cập nhật thông tin
                giảng viên <strong>@Model.HoTen</strong> không?
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Hủy
                </button>

                <button type="button"
                        id="btnXacNhanSua"
                        class="btn btn-main">
                    <i class="fa-solid fa-check"></i>
                    Xác nhận
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("formSuaGiangVien");
            const btnMo = document.getElementById("btnMoXacNhanSua");
            const btnXacNhan = document.getElementById("btnXacNhanSua");
            const modalElement = document.getElementById("modalXacNhanSua");

            if (!form || !btnMo || !btnXacNhan || !modalElement) return;

            btnMo.addEventListener("click", function () {
                if (window.jQuery &&
                    typeof window.jQuery.fn.valid === "function") {
                    if (!window.jQuery(form).valid()) return;
                } else if (!form.reportValidity()) {
                    return;
                }

                bootstrap.Modal.getOrCreateInstance(modalElement).show();
            });

            btnXacNhan.addEventListener("click", function () {
                btnXacNhan.disabled = true;
                form.requestSubmit();
            });
        });
    </script>
}
