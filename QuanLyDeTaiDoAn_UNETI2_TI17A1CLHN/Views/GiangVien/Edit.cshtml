@model QuanLyDeTaiDoAn.Models.GiangVien

@{
    ViewData["Title"] = "Sửa giảng viên";
}

<div class="content-card p-4">

    <h2 class="page-title mb-4">
        Sửa giảng viên
    </h2>

    <form asp-action="Edit">

        <input type="hidden"
               asp-for="MaGiangVien" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="row g-3">

            <div class="col-md-6">
                <label asp-for="HoTen"
                       class="form-label"></label>

                <input asp-for="HoTen"
                       class="form-control" />

                <span asp-validation-for="HoTen"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="HocVi"
                       class="form-label"></label>

                <input asp-for="HocVi"
                       class="form-control" />

                <span asp-validation-for="HocVi"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Email"
                       class="form-label"></label>

                <input asp-for="Email"
                       class="form-control" />

                <span asp-validation-for="Email"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="SoDienThoai"
                       class="form-label"></label>

                <input asp-for="SoDienThoai"
                       class="form-control" />

                <span asp-validation-for="SoDienThoai"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="MaLinhVuc"
                       class="form-label"></label>

                <select asp-for="MaLinhVuc"
                        asp-items="ViewBag.MaLinhVuc"
                        class="form-select">
                </select>

                <span asp-validation-for="MaLinhVuc"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="SoSinhVienHuongDanToiDa"
                       class="form-label"></label>

                <input asp-for="SoSinhVienHuongDanToiDa"
                       type="number"
                       min="1"
                       class="form-control" />

                <span asp-validation-for="SoSinhVienHuongDanToiDa"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="TrangThai"
                       class="form-label"></label>

                <select asp-for="TrangThai"
                        class="form-select">
                    <option value="Đang công tác">
                        Đang công tác
                    </option>

                    <option value="Tạm ngừng hướng dẫn">
                        Tạm ngừng hướng dẫn
                    </option>
                </select>
            </div>

        </div>

        <div class="text-end mt-4">
            <a asp-action="Index"
               class="btn btn-light border">
                Hủy
            </a>

            <button class="btn btn-primary">
                Lưu thay đổi
            </button>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}