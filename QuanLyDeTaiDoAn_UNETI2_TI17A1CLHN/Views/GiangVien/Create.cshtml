@model QuanLyDeTaiDoAn.Models.GiangVien

@{
    ViewData["Title"] = "Thêm giảng viên";
}

<div class="content-card">

    <div class="p-4">

        <h2 class="page-title mb-4">
            Thêm giảng viên
        </h2>

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert">
            </div>

            <div class="row g-3">


                <div class="col-md-6">
                    <label asp-for="HoTen"
                           class="form-label fw-semibold">
                        Họ tên <span class="text-danger">*</span>
                    </label>

                    <input asp-for="HoTen"
                           class="form-control"
                           placeholder="Nhập họ tên giảng viên" />

                    <span asp-validation-for="HoTen"
                          class="text-danger small"></span>
                </div>

   
                <div class="col-md-6">
                    <label asp-for="HocVi"
                           class="form-label fw-semibold">
                        Học vị <span class="text-danger">*</span>
                    </label>

                    <select asp-for="HocVi"
                            class="form-select">

                        <option value="">
                            -- Chọn học vị --
                        </option>

                        <option value="ThS">ThS</option>
                        <option value="TS">TS</option>
                        <option value="PGS.TS">PGS.TS</option>
                        <option value="GS.TS">GS.TS</option>

                    </select>

                    <span asp-validation-for="HocVi"
                          class="text-danger small"></span>
                </div>

 
                <div class="col-md-6">
                    <label asp-for="Email"
                           class="form-label fw-semibold">
                        Email <span class="text-danger">*</span>
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="Nhập email" />

                    <span asp-validation-for="Email"
                          class="text-danger small"></span>
                </div>

      
                <div class="col-md-6">
                    <label asp-for="SoDienThoai"
                           class="form-label fw-semibold">
                        Số điện thoại
                    </label>

                    <input asp-for="SoDienThoai"
                           class="form-control"
                           placeholder="Nhập số điện thoại" />

                    <span asp-validation-for="SoDienThoai"
                          class="text-danger small"></span>
                </div>

     
                <div class="col-md-6">
                    <label asp-for="MaLinhVuc"
                           class="form-label fw-semibold">
                        Lĩnh vực <span class="text-danger">*</span>
                    </label>

                    <select asp-for="MaLinhVuc"
                            asp-items="ViewBag.MaLinhVuc"
                            class="form-select">

                        <option value="">
                            -- Chọn lĩnh vực --
                        </option>

                    </select>

                    <span asp-validation-for="MaLinhVuc"
                          class="text-danger small"></span>
                </div>

           
                <div class="col-md-6">
                    <label asp-for="SoSinhVienHuongDanToiDa"
                           class="form-label fw-semibold">
                        Số sinh viên hướng dẫn tối đa
                        <span class="text-danger">*</span>
                    </label>

                    <input asp-for="SoSinhVienHuongDanToiDa"
                           type="number"
                           min="1"
                           class="form-control"
                           placeholder="Nhập số lượng" />

                    <span asp-validation-for="SoSinhVienHuongDanToiDa"
                          class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="TrangThai"
                           class="form-label fw-semibold">
                        Trạng thái
                    </label>

                    <select asp-for="TrangThai"
                            class="form-select">

                        <option value="Đang công tác">
                            Đang công tác
                        </option>

                        <option value="Tạm ngừng hướng dẫn">
                            Tạm ngừng hướng dẫn
                        </option>

                    </select>

                    <span asp-validation-for="TrangThai"
                          class="text-danger small"></span>
                </div>

            </div>

  
            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">

                <a asp-action="Index"
                   class="btn btn-light border px-4">
                    Hủy
                </a>

                <button type="submit"
                        class="btn btn-primary px-4">

                    <i class="fa-solid fa-floppy-disk me-1"></i>
                    Lưu

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}