@model QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models.GiangVien

@{
    ViewData["Title"] = "Thêm giảng viên";
}

<div class="content-card">
    <div class="p-3 p-lg-4">
        <div class="mb-4">
            <h2 class="page-title mb-1">
                <i class="fa-solid fa-user-plus me-2"></i>
                Thêm giảng viên
            </h2>
            <p class="page-description mb-0">
                Nhập thông tin giảng viên hướng dẫn
            </p>
        </div>

        <form asp-controller="GiangVien"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row g-3">

                <div class="col-md-6">
                    <label asp-for="HoTen" class="form-label">
                        Họ và tên <span class="text-danger">*</span>
                    </label>
                    <input asp-for="HoTen"
                           class="form-control"
                           placeholder="Nhập họ tên giảng viên" />
                    <span asp-validation-for="HoTen" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="HocVi" class="form-label">
                        Học vị <span class="text-danger">*</span>
                    </label>
                    <input asp-for="HocVi"
                           class="form-control"
                           placeholder="Ví dụ: Thạc sĩ, Tiến sĩ..." />
                    <span asp-validation-for="HocVi" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">
                        Email <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="example@uneti.edu.vn" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SoDienThoai" class="form-label">
                        Số điện thoại
                    </label>
                    <input asp-for="SoDienThoai"
                           type="tel"
                           class="form-control"
                           placeholder="Nhập số điện thoại" />
                    <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MaLinhVuc" class="form-label">
                        Lĩnh vực <span class="text-danger">*</span>
                    </label>
                    <select asp-for="MaLinhVuc"
                            asp-items="ViewBag.MaLinhVuc"
                            class="form-select">
                        <option value="0">-- Chọn lĩnh vực --</option>
                    </select>
                    <span asp-validation-for="MaLinhVuc" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SoSinhVienHuongDanToiDa"
                           class="form-label">
                        Số sinh viên hướng dẫn tối đa
                        <span class="text-danger">*</span>
                    </label>
                    <input asp-for="SoSinhVienHuongDanToiDa"
                           type="number"
                           min="1"
                           class="form-control" />
                    <span asp-validation-for="SoSinhVienHuongDanToiDa"
                          class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label class="form-label d-block">
                        Trạng thái <span class="text-danger">*</span>
                    </label>

                    <div class="form-check form-check-inline">
                        <input asp-for="TrangThai"
                               type="radio"
                               value="Đang công tác"
                               id="createDangCongTac"
                               class="form-check-input" />
                        <label for="createDangCongTac"
                               class="form-check-label">
                            Đang công tác
                        </label>
                    </div>

                    <div class="form-check form-check-inline">
                        <input asp-for="TrangThai"
                               type="radio"
                               value="Tạm ngừng hướng dẫn"
                               id="createTamNgung"
                               class="form-check-input" />
                        <label for="createTamNgung"
                               class="form-check-label">
                            Tạm ngừng hướng dẫn
                        </label>
                    </div>

                    <span asp-validation-for="TrangThai"
                          class="text-danger d-block"></span>
                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2 flex-wrap">
                <a asp-controller="GiangVien"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left"></i>
                    Quay lại
                </a>

                <button type="submit" class="btn btn-main">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Lưu giảng viên
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
