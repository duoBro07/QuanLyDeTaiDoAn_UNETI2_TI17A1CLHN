@model QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models.GiangVien

@{
    ViewData["Title"] = "Tạm ngừng hướng dẫn";

    bool daTamNgung =
        Model.TrangThai == "Tạm ngừng hướng dẫn";
}

<div class="content-card">
    <div class="p-3 p-lg-4">

        <div class="mb-4">
            <h2 class="page-title mb-1">
                <i class="fa-solid fa-trash text-danger me-2"></i>
                Tạm ngừng hướng dẫn
            </h2>

            <p class="page-description mb-0">
                Xác nhận thay đổi trạng thái giảng viên
            </p>
        </div>

        @if (daTamNgung)
        {
            <div class="alert alert-info">
                <i class="fa-solid fa-circle-info me-2"></i>
                Giảng viên này hiện đã ở trạng thái tạm ngừng hướng dẫn.
            </div>
        }
        else
        {
            <div class="uneti-delete-warning">
                <div class="fw-bold mb-2">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                    Xác nhận tạm ngừng giảng viên
                </div>

                Bạn có chắc chắn muốn chuyển giảng viên
                <strong>@Model.HoTen</strong>
                sang trạng thái tạm ngừng hướng dẫn?
            </div>
        }

        <div class="alert alert-warning">
            <i class="fa-solid fa-circle-info me-2"></i>
            Hồ sơ và lịch sử phân công vẫn được giữ lại.
            Nếu giảng viên đang có phân công hiệu lực,
            hệ thống sẽ không cho phép tạm ngừng.
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Mã giảng viên</div>
            <div class="uneti-details-value">@Model.MaGiangVien</div>
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Họ và tên</div>
            <div class="uneti-details-value fw-semibold">@Model.HoTen</div>
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Học vị</div>
            <div class="uneti-details-value">@Model.HocVi</div>
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Email</div>
            <div class="uneti-details-value">@Model.Email</div>
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Lĩnh vực</div>
            <div class="uneti-details-value">
                @(Model.LinhVuc?.TenLinhVuc ?? "Chưa có")
            </div>
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Trạng thái hiện tại</div>
            <div class="uneti-details-value">@Model.TrangThai</div>
        </div>

        <form asp-controller="GiangVien"
              asp-action="Delete"
              asp-route-id="@Model.MaGiangVien"
              method="post"
              id="formTamNgungGiangVien" data-no-confirm="true">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.MaGiangVien" />

            <div class="uneti-delete-actions justify-content-end">

                <a asp-controller="GiangVien"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left"></i>
                    Quay lại
                </a>

                @if (!daTamNgung)
                {
                    <button type="button"
                            class="btn btn-danger"
                            data-bs-toggle="modal"
                            data-bs-target="#modalTamNgung">
                        <i class="fa-solid fa-trash"></i>
                        Tạm ngừng hướng dẫn
                    </button>
                }

            </div>
        </form>

    </div>
</div>

@if (!daTamNgung)
{
    <div class="modal fade"
         id="modalTamNgung"
         tabindex="-1"
         aria-labelledby="tieuDeTamNgung"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="tieuDeTamNgung">
                        <i class="fa-solid fa-triangle-exclamation text-danger me-2"></i>
                        Xác nhận tạm ngừng
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Đóng"></button>
                </div>

                <div class="modal-body">
                    Bạn muốn tạm ngừng hướng dẫn đối với
                    <strong>@Model.HoTen</strong>?

                    <p class="text-muted mt-2 mb-0">
                        Hồ sơ giảng viên và lịch sử hướng dẫn
                        sẽ không bị xóa.
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Hủy
                    </button>

                    <button type="button"
                            id="btnXacNhanTamNgung"
                            class="btn btn-danger">
                        <i class="fa-solid fa-check"></i>
                        Xác nhận
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const btn = document.getElementById("btnXacNhanTamNgung");
            const form = document.getElementById("formTamNgungGiangVien");

            if (!btn || !form) return;

            btn.addEventListener("click", function () {
                btn.disabled = true;
                form.requestSubmit();
            });
        });
    </script>
}
