
@model QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.ViewModels.DangKyFormVM
@{ ViewData["Title"] = "Đăng ký đề tài"; }
<h3 class="mb-3">Đăng ký đề tài</h3>
<div class="m3-card">
    @if (Model.ThongBaoKhongDangKy != null)
    {
        <div class="alert alert-danger">Không thể đăng ký: @Model.ThongBaoKhongDangKy</div>
    }
    <form asp-action="Create" method="post">
        <input type="hidden" asp-for="MaDeTai" />
        <div class="mb-3">
            <label class="form-label">Đề tài</label>
            <input class="form-control" value="@Model.TenDeTai" readonly />
            <div class="form-text">Lĩnh vực: @Model.TenLinhVuc</div>
        </div>
        <div class="mb-3">
            <label asp-for="LyDoDangKy" class="form-label"></label> <span class="text-danger">*</span>
            <textarea asp-for="LyDoDangKy" class="form-control" rows="4" placeholder="Nhập lý do đăng ký..."></textarea>
            <span asp-validation-for="LyDoDangKy" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2 justify-content-end">
            <a asp-controller="TraCuuDeTai" asp-action="Details" asp-route-id="@Model.MaDeTai" class="btn btn-light border">Hủy</a>
            @if (Model.ThongBaoKhongDangKy == null) { <button class="btn btn-primary">Đăng ký</button> }
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
