@using QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models

@{
    ViewData["Title"] = "Đăng ký đề tài";

    var deTai = ViewBag.DeTai as DeTai;
    int soChoCon = ViewBag.SoChoCon ?? 0;
    string lyDo = ViewBag.LyDoDangKy as string ?? "";
}

<div class="content-card">
    <div class="p-3 p-lg-4">

        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">

            <div>
                <h2 class="page-title mb-1">
                    <i class="fa-solid fa-file-circle-plus me-2"></i>
                    Đăng ký đề tài
                </h2>

                <p class="page-description mb-0">
                    Kiểm tra thông tin đề tài và nhập lý do đăng ký
                </p>
            </div>

            <a asp-controller="CongSinhVien"
               asp-action="DeTai"
               class="btn btn-outline-secondary">

                <i class="fa-solid fa-arrow-left"></i>
                Quay lại danh sách
            </a>

        </div>

        @if (deTai == null)
        {
            <div class="alert alert-danger">
                <i class="fa-solid fa-circle-exclamation me-2"></i>
                Không tìm thấy thông tin đề tài.
            </div>

            <a asp-controller="CongSinhVien"
               asp-action="DeTai"
               class="btn btn-main">
                Xem danh sách đề tài
            </a>
        }
        else
        {
            <div asp-validation-summary="All"
                 class="text-danger mb-3"></div>

            <h5 class="fw-bold mb-3" style="color:#17477e">
                <i class="fa-solid fa-book-open me-2"></i>
                Thông tin đề tài
            </h5>

            <div class="uneti-details-row">
                <div class="uneti-details-label">
                    Mã đề tài
                </div>

                <div class="uneti-details-value">
                    @deTai.MaDeTai
                </div>
            </div>

            <div class="uneti-details-row">
                <div class="uneti-details-label">
                    Tên đề tài
                </div>

                <div class="uneti-details-value fw-semibold">
                    @deTai.TenDeTai
                </div>
            </div>

            <div class="uneti-details-row">
                <div class="uneti-details-label">
                    Lĩnh vực
                </div>

                <div class="uneti-details-value">
                    @(deTai.LinhVuc?.TenLinhVuc ?? "Chưa cập nhật")
                </div>
            </div>

            <div class="uneti-details-row">
                <div class="uneti-details-label">
                    Năm học
                </div>

                <div class="uneti-details-value">
                    @deTai.NamHoc
                </div>
            </div>

            <div class="uneti-details-row">
                <div class="uneti-details-label">
                    Học kỳ
                </div>

                <div class="uneti-details-value">
                    Học kỳ @deTai.HocKy
                </div>
            </div>

            <div class="uneti-details-row">
                <div class="uneti-details-label">
                    Số sinh viên tối đa
                </div>

                <div class="uneti-details-value">
                    @deTai.SoSinhVienToiDa
                </div>
            </div>

            <div class="uneti-details-row">
                <div class="uneti-details-label">
                    Số chỗ còn
                </div>

                <div class="uneti-details-value">

                    @if (soChoCon > 0)
                    {
                        <span class="uneti-status uneti-status-success">
                            <i class="fa-solid fa-circle-check me-1"></i>
                            @soChoCon chỗ
                        </span>
                    }
                    else
                    {
                        <span class="uneti-status uneti-status-danger">
                            Đã hết chỗ
                        </span>
                    }

                </div>
            </div>

            <div class="uneti-details-row">
                <div class="uneti-details-label">
                    Trạng thái
                </div>

                <div class="uneti-details-value">
                    <span class="uneti-status uneti-status-success">
                        @deTai.TrangThai
                    </span>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(deTai.MoTa))
            {
                <div class="uneti-details-row">
                    <div class="uneti-details-label">
                        Mô tả
                    </div>

                    <div class="uneti-details-value"
                         style="white-space:pre-wrap">
                        @deTai.MoTa
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(deTai.YeuCau))
            {
                <div class="uneti-details-row">
                    <div class="uneti-details-label">
                        Yêu cầu
                    </div>

                    <div class="uneti-details-value"
                         style="white-space:pre-wrap">
                        @deTai.YeuCau
                    </div>
                </div>
            }

            <hr class="my-4" />

            <h5 class="fw-bold mb-3" style="color:#17477e">
                <i class="fa-solid fa-pen-to-square me-2"></i>
                Thông tin đăng ký
            </h5>

            <form asp-controller="DangKyDeTai"
                  asp-action="Create"
                  asp-route-id="@deTai.MaDeTai"
                  method="post"
                  id="formDangKy" data-no-confirm="true">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@deTai.MaDeTai" />

                <div class="mb-3">
                    <label for="lyDoDangKy"
                           class="form-label">
                        Lý do đăng ký đề tài
                        <span class="text-danger">*</span>
                    </label>

                    <textarea id="lyDoDangKy"
                              name="lyDoDangKy"
                              class="form-control"
                              rows="6"
                              maxlength="1000"
                              required
                              placeholder="Trình bày lý do bạn lựa chọn đề tài này, kiến thức và kỹ năng phù hợp...">@lyDo</textarea>

                    <div class="d-flex justify-content-between mt-2">
                        <small class="text-muted">
                            Tối đa 1.000 ký tự
                        </small>

                        <small class="text-muted" id="demKyTu">
                            0/1000
                        </small>
                    </div>
                </div>

                <div class="alert alert-info">
                    <i class="fa-solid fa-circle-info me-2"></i>
                    Sau khi gửi, đăng ký sẽ ở trạng thái
                    <strong>Chờ duyệt</strong>.
                    Bạn có thể hủy đăng ký khi chưa được xét duyệt.
                </div>

                <div class="d-flex justify-content-end gap-2 flex-wrap">

                    <a asp-controller="CongSinhVien"
                       asp-action="DeTai"
                       class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left"></i>
                        Quay lại
                    </a>

                    <button type="button"
                            id="btnMoXacNhan"
                            class="btn btn-main"
                            disabled="@(soChoCon <= 0)">

                        <i class="fa-solid fa-paper-plane"></i>
                        Gửi đăng ký
                    </button>

                </div>

            </form>

            <!-- MODAL XAC NHAN GUI -->

            <div class="modal fade"
                 id="modalXacNhanDangKy"
                 tabindex="-1"
                 aria-labelledby="tieuDeXacNhanDangKy"
                 aria-hidden="true">

                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title"
                                id="tieuDeXacNhanDangKy">

                                <i class="fa-solid fa-circle-question me-2"></i>
                                Xác nhận gửi đăng ký
                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal"
                                    aria-label="Đóng"></button>
                        </div>

                        <div class="modal-body">

                            Bạn có chắc chắn muốn đăng ký đề tài:

                            <strong>@deTai.TenDeTai</strong>?

                            <p class="text-muted small mt-2 mb-0">
                                Hồ sơ sẽ được chuyển tới quản trị viên xét duyệt.
                            </p>

                        </div>

                        <div class="modal-footer">

                            <button type="button"
                                    class="btn btn-outline-secondary"
                                    data-bs-dismiss="modal">
                                Hủy
                            </button>

                            <button type="button"
                                    id="btnXacNhanGui"
                                    class="btn btn-main">

                                <i class="fa-solid fa-check"></i>
                                Xác nhận gửi
                            </button>

                        </div>

                    </div>
                </div>
            </div>
        }

    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const textarea = document.getElementById("lyDoDangKy");
            const counter = document.getElementById("demKyTu");
            const form = document.getElementById("formDangKy");
            const btnMo = document.getElementById("btnMoXacNhan");
            const btnGui = document.getElementById("btnXacNhanGui");
            const modalElement = document.getElementById("modalXacNhanDangKy");

            if (!textarea || !form || !btnMo || !btnGui || !modalElement) {
                return;
            }

            function capNhatKyTu() {
                if (counter) {
                    counter.textContent = textarea.value.length + "/1000";
                }
            }

            textarea.addEventListener("input", capNhatKyTu);
            capNhatKyTu();

            btnMo.addEventListener("click", function () {

                textarea.value = textarea.value.trim();
                capNhatKyTu();

                if (!form.reportValidity()) {
                    return;
                }

                if (!textarea.value) {
                    textarea.setCustomValidity("Vui lòng nhập lý do đăng ký.");
                    textarea.reportValidity();
                    textarea.setCustomValidity("");
                    return;
                }

                if (!window.bootstrap) {
                    alert("Không thể mở hộp thoại xác nhận. Vui lòng tải lại trang.");
                    return;
                }

                bootstrap.Modal.getOrCreateInstance(modalElement).show();
            });

            btnGui.addEventListener("click", function () {

                if (btnGui.disabled) return;

                btnGui.disabled = true;
                btnGui.textContent = "Đang gửi...";

                form.submit();
            });

        });
    </script>
}
