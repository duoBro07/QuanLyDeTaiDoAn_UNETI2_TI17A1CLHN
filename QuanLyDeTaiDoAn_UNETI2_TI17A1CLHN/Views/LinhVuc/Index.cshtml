@model IEnumerable<QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models.LinhVuc>
@{ ViewData["Title"] = "Quản lý lĩnh vực đề tài"; }
<div class="page-card">
    <div class="page-card-header">
        <div><h4>Danh sách lĩnh vực đề tài</h4><small class="text-secondary">Lĩnh vực được Module 2 dùng cho Giảng viên và Đề tài</small></div>
        <a asp-action="Create" class="btn-main">+ Thêm lĩnh vực</a>
    </div>
    <div class="page-card-body">
        @if (!Model.Any())
        {
            <div class="empty-state"><strong>Chưa có lĩnh vực.</strong><span>Hãy tạo lĩnh vực đầu tiên để sử dụng cho đề tài.</span></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead><tr><th>Mã</th><th>Tên lĩnh vực</th><th>Mô tả</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.MaLinhVuc</td>
                            <td><strong>@item.TenLinhVuc</strong></td>
                            <td class="description-cell">@(string.IsNullOrWhiteSpace(item.MoTa) ? "Chưa có mô tả" : item.MoTa)</td>
                            <td>@if(item.TrangThai){<span class="status-active">Hoạt động</span>}else{<span class="status-off">Ngừng hoạt động</span>}</td>
                            <td><div class="action-group"><a asp-action="Details" asp-route-id="@item.MaLinhVuc" class="action-link">Xem</a><a asp-action="Edit" asp-route-id="@item.MaLinhVuc" class="action-link">Sửa</a><a asp-action="Delete" asp-route-id="@item.MaLinhVuc" class="action-link action-link-danger">Xóa</a></div></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
