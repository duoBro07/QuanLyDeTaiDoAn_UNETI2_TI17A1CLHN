@model QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models.LinhVuc
@{ ViewData["Title"] = "Xóa lĩnh vực"; }
<div class="center-message"><div class="message-card danger-message">
    <div class="message-icon warning-icon">!</div><h2>Xác nhận xóa lĩnh vực</h2>
    <p>Bạn có chắc chắn muốn xóa <strong>"@Model.TenLinhVuc"</strong>?</p>
    <div class="integration-note">@ViewBag.IntegrationNote</div>
    <form asp-action="Delete" asp-route-id="@Model.MaLinhVuc" method="post"><div class="d-flex gap-2 justify-content-center mt-4"><a asp-action="Index" class="btn-soft">Hủy</a><button type="submit" class="btn-danger-soft">Xóa lĩnh vực</button></div></form>
</div></div>
