@model QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models.LinhVuc
@{ ViewData["Title"] = "Sửa lĩnh vực"; }
<div class="form-page-wrap"><div class="page-card form-card">
    <div class="page-card-header"><div><h4>Sửa thông tin lĩnh vực</h4><small class="text-secondary">Có thể cập nhật trạng thái hoạt động tại đây</small></div></div>
    <div class="page-card-body"><form asp-action="Edit" asp-route-id="@Model.MaLinhVuc" method="post">
        <input type="hidden" asp-for="MaLinhVuc" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="TenLinhVuc" class="form-label">Tên lĩnh vực *</label><input asp-for="TenLinhVuc" class="form-control" /><span asp-validation-for="TenLinhVuc" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="MoTa" class="form-label">Mô tả</label><textarea asp-for="MoTa" class="form-control"></textarea><span asp-validation-for="MoTa" class="text-danger"></span></div>
        <div class="form-check my-4"><input asp-for="TrangThai" class="form-check-input" /><label asp-for="TrangThai" class="form-check-label">Hoạt động</label></div>
        <div class="d-flex gap-2"><a asp-action="Index" class="btn-soft">Hủy</a><button type="submit" class="btn-main">Lưu thay đổi</button></div>
    </form></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
