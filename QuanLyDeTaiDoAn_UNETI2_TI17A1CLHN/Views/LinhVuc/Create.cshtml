@model QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models.LinhVuc
@{ ViewData["Title"] = "Thêm lĩnh vực"; }
<div class="form-page-wrap"><div class="page-card form-card">
    <div class="page-card-header"><div><h4>Thêm lĩnh vực mới</h4><small class="text-secondary">Tên lĩnh vực bắt buộc và không được trùng</small></div></div>
    <div class="page-card-body"><form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="TenLinhVuc" class="form-label">Tên lĩnh vực *</label><input asp-for="TenLinhVuc" class="form-control" placeholder="Ví dụ: Công nghệ thông tin" /><span asp-validation-for="TenLinhVuc" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="MoTa" class="form-label">Mô tả</label><textarea asp-for="MoTa" class="form-control" placeholder="Nhập mô tả lĩnh vực"></textarea><span asp-validation-for="MoTa" class="text-danger"></span></div>
        <div class="form-check my-4"><input asp-for="TrangThai" class="form-check-input" /><label asp-for="TrangThai" class="form-check-label">Hoạt động</label></div>
        <div class="d-flex gap-2"><a asp-action="Index" class="btn-soft">Hủy</a><button type="submit" class="btn-main">Lưu lĩnh vực</button></div>
    </form></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
