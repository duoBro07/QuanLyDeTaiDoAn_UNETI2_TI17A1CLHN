@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Đăng nhập | Hệ thống quản lý đề tài đồ án UNETI</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>
            :root {
                --navy: #083a70;
                --navy-dark: #062b55;
                --blue: #1267c9;
                --blue-hover: #0956af;
                --blue-light: #eaf3ff;
                --text: #193653;
                --muted: #71849a;
                --border: #dce6f1;
                --background: #f3f7fc;
            }

            * {
                box-sizing: border-box;
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                margin: 0;
                min-height: 100vh;
                font-family: "Segoe UI", Arial, sans-serif;
                color: var(--text);
                background: var(--background);
            }

            button,
            input {
                font: inherit;
            }

            /* ================= HEADER ================= */

            .site-header {
                background: linear-gradient( 105deg, #062d5a 0%, #084b91 65%, #1268b5 100% );
                color: white;
                border-bottom: 3px solid #46a6f5;
            }

            .header-container {
                width: min(1200px, calc(100% - 48px));
                min-height: 88px;
                margin: 0 auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 25px;
            }

            .header-brand {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .header-logo {
                width: 56px;
                height: 56px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 14px;
                background: #ffffff;
                color: var(--navy);
                box-shadow: 0 4px 15px rgba(0,0,0,.12);
            }

                .header-logo i {
                    font-size: 29px;
                }

            .header-title {
                margin: 0 0 5px;
                font-size: 20px;
                font-weight: 750;
                letter-spacing: .3px;
            }

            .header-subtitle {
                margin: 0;
                color: #d4e9ff;
                font-size: 12px;
            }

            .header-badge {
                display: flex;
                align-items: center;
                gap: 9px;
                padding: 10px 15px;
                border: 1px solid rgba(255,255,255,.24);
                border-radius: 30px;
                background: rgba(255,255,255,.10);
                color: #ffffff;
                font-size: 12px;
                white-space: nowrap;
            }

                .header-badge i {
                    color: #9fdbff;
                }

            /* ================= MAIN ================= */

            .main-container {
                width: min(1200px, calc(100% - 48px));
                margin: 0 auto;
                padding: 35px 0 38px;
            }

            .welcome-text {
                margin-bottom: 23px;
            }

            .welcome-label {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 7px 13px;
                border-radius: 30px;
                background: #e3efff;
                color: #1463b5;
                font-size: 12px;
                font-weight: 650;
            }

            .welcome-text h1 {
                margin: 12px 0 7px;
                font-size: 26px;
                font-weight: 750;
                color: #153c68;
            }

            .welcome-text p {
                margin: 0;
                color: var(--muted);
                font-size: 14px;
            }

            /* ================= KHUNG CHÍNH ================= */

            .portal-card {
                display: grid;
                grid-template-columns: 55% 45%;
                min-height: 460px;
                overflow: hidden;
                border-radius: 16px;
                background: #ffffff;
                border: 1px solid #e4ebf4;
                box-shadow: 0 12px 35px rgba(30, 70, 120, .08);
            }

            /* ================= ẢNH TRƯỜNG ================= */

            .portal-banner {
                position: relative;
                display: flex;
                align-items: flex-end;
                padding: 42px;
                background: linear-gradient( 180deg, rgba(4, 34, 76, .08) 0%, rgba(5, 40, 85, .55) 45%, rgba(3, 32, 73, .94) 100% ), url('/images/uneti-campus.jpg') center center / cover no-repeat;
                background-color: #124b83;
            }

                .portal-banner::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background: linear-gradient( 120deg, rgba(4, 48, 99, .22), transparent 65% );
                    pointer-events: none;
                }

            .banner-content {
                position: relative;
                z-index: 1;
                color: white;
                max-width: 490px;
            }

            .banner-tag {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 17px;
                padding: 8px 13px;
                background: rgba(255,255,255,.16);
                border: 1px solid rgba(255,255,255,.25);
                border-radius: 30px;
                backdrop-filter: blur(6px);
                color: white;
                font-size: 12px;
                font-weight: 600;
            }

            .banner-title {
                margin: 0 0 13px;
                font-size: 31px;
                line-height: 1.3;
                font-weight: 750;
                color: white;
            }

            .banner-description {
                margin: 0;
                font-size: 14px;
                line-height: 1.8;
                color: rgba(255,255,255,.9);
            }

            .banner-divider {
                width: 55px;
                height: 3px;
                margin: 20px 0;
                background: #65c5ff;
                border-radius: 4px;
            }

            .banner-school {
                display: flex;
                align-items: center;
                gap: 9px;
                color: #d6eaff;
                font-size: 12px;
            }

            /* ================= FORM ĐĂNG NHẬP ================= */

            .login-panel {
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 42px 50px;
                background: white;
            }

            .login-box {
                width: 100%;
                max-width: 365px;
            }

            .login-heading {
                margin-bottom: 29px;
            }

                .login-heading .heading-icon {
                    width: 43px;
                    height: 43px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    margin-bottom: 16px;
                    background: var(--blue-light);
                    border-radius: 12px;
                    color: var(--blue);
                    font-size: 19px;
                }

                .login-heading h2 {
                    margin: 0 0 8px;
                    color: #14375e;
                    font-size: 26px;
                    font-weight: 750;
                }

                .login-heading p {
                    margin: 0;
                    color: var(--muted);
                    font-size: 13px;
                }

            .form-group {
                margin-bottom: 20px;
            }

            .form-label {
                display: block;
                margin-bottom: 9px;
                color: #354b65;
                font-size: 13px;
                font-weight: 650;
            }

            .input-wrapper {
                position: relative;
            }

            .input-icon {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: #90a0b4;
                font-size: 15px;
                pointer-events: none;
            }

            .form-input {
                width: 100%;
                height: 47px;
                padding: 0 44px;
                background: #f9fbfe;
                border: 1px solid var(--border);
                border-radius: 8px;
                outline: none;
                color: var(--text);
                font-size: 13px;
                transition: .2s;
            }

                .form-input::placeholder {
                    color: #9eacbc;
                }

                .form-input:focus {
                    background: white;
                    border-color: var(--blue);
                    box-shadow: 0 0 0 3px rgba(18,103,201,.10);
                }

            .password-toggle {
                position: absolute;
                top: 50%;
                right: 12px;
                transform: translateY(-50%);
                padding: 7px;
                border: none;
                background: transparent;
                color: #91a2b5;
                font-size: 15px;
                cursor: pointer;
            }

                .password-toggle:hover {
                    color: var(--blue);
                }

            /* ================= GHI NHỚ ================= */

            .form-options {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
                margin: 4px 0 24px;
            }

            .remember-label {
                display: flex;
                align-items: center;
                gap: 9px;
                color: #65788f;
                font-size: 12px;
                cursor: pointer;
            }

                .remember-label input {
                    width: 15px;
                    height: 15px;
                    margin: 0;
                    accent-color: var(--blue);
                }

            .secure-note {
                display: flex;
                align-items: center;
                gap: 5px;
                color: #8393a7;
                font-size: 11px;
            }

            /* ================= BUTTON ================= */

            .login-button {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                width: 100%;
                height: 47px;
                border: none;
                border-radius: 8px;
                background: linear-gradient( 90deg, #1264c3, #1978dd );
                color: white;
                font-size: 14px;
                font-weight: 700;
                cursor: pointer;
                transition: .2s;
                box-shadow: 0 5px 13px rgba(18,100,195,.17);
            }

                .login-button:hover {
                    background: linear-gradient( 90deg, #0b53a7, #1067c5 );
                    transform: translateY(-1px);
                }

            .login-help {
                margin-top: 21px;
                color: #98a6b7;
                font-size: 11px;
                text-align: center;
            }

            /* ================= THÔNG BÁO LỖI ================= */

            .error-box {
                display: flex;
                align-items: flex-start;
                gap: 9px;
                margin-bottom: 19px;
                padding: 12px 14px;
                background: #fff1f0;
                border: 1px solid #f3c5c1;
                border-radius: 8px;
                color: #b42318;
                font-size: 12px;
                line-height: 1.6;
            }

                .error-box i {
                    margin-top: 3px;
                }

            /* ================= TÍNH NĂNG ================= */

            .features-title {
                margin: 30px 0 16px;
                color: #193c65;
                font-size: 17px;
                font-weight: 700;
            }

            .features-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 18px;
            }

            .feature-card {
                display: flex;
                align-items: center;
                gap: 15px;
                padding: 21px 22px;
                background: white;
                border: 1px solid #e3ebf5;
                border-radius: 12px;
                box-shadow: 0 5px 18px rgba(30,70,120,.035);
                transition: .2s;
            }

                .feature-card:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 10px 24px rgba(30,70,120,.09);
                }

            .feature-icon {
                width: 48px;
                height: 48px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 12px;
                background: #eaf3ff;
                color: #1467c6;
                font-size: 21px;
            }

            .feature-card:nth-child(2) .feature-icon {
                background: #e9f8f2;
                color: #15966b;
            }

            .feature-card:nth-child(3) .feature-icon {
                background: #fff3e8;
                color: #d9872a;
            }

            .feature-info h3 {
                margin: 0 0 5px;
                font-size: 14px;
                font-weight: 700;
                color: #234567;
            }

            .feature-info p {
                margin: 0;
                color: #8190a2;
                font-size: 12px;
                line-height: 1.5;
            }

            /* ================= FOOTER ================= */

            .site-footer {
                background: white;
                border-top: 1px solid #e5ebf3;
            }

            .footer-container {
                width: min(1200px, calc(100% - 48px));
                min-height: 62px;
                margin: 0 auto;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 15px;
                color: #8b9bae;
                font-size: 12px;
            }

            .footer-right {
                display: flex;
                align-items: center;
                gap: 8px;
            }

            /* ================= RESPONSIVE ================= */

            @@media (max-width: 1000px) {

                .portal-card {
                    grid-template-columns: 50% 50%;
                }

                .portal-banner {
                    padding: 30px;
                }

                .login-panel {
                    padding: 35px;
                }

                .banner-title {
                    font-size: 26px;
                }
            }

            @@media (max-width: 760px) {

                .header-container {
                    min-height: 80px;
                }

                .header-title {
                    font-size: 16px;
                }

                .header-subtitle {
                    font-size: 11px;
                }

                .header-badge {
                    display: none;
                }

                .portal-card {
                    grid-template-columns: 1fr;
                }

                .portal-banner {
                    min-height: 300px;
                }

                .login-panel {
                    padding: 38px 30px;
                }

                .features-grid {
                    grid-template-columns: 1fr;
                }

                .footer-container {
                    flex-direction: column;
                    justify-content: center;
                    padding: 18px 0;
                    text-align: center;
                }
            }

            @@media (max-width: 480px) {

                .header-container,
                .main-container,
                .footer-container {
                    width: calc(100% - 28px);
                }

                .header-logo {
                    width: 46px;
                    height: 46px;
                }

                    .header-logo i {
                        font-size: 24px;
                    }

                .header-title {
                    font-size: 13px;
                }

                .header-subtitle {
                    font-size: 10px;
                }

                .welcome-text h1 {
                    font-size: 21px;
                }

                .portal-banner {
                    min-height: 270px;
                    padding: 25px;
                }

                .banner-title {
                    font-size: 24px;
                }

                .login-panel {
                    padding: 32px 23px;
                }

                .feature-card {
                    padding: 17px;
                }
            }
    </style>
</head>

<body>

    <!-- HEADER -->

    <header class="site-header">

        <div class="header-container">

            <div class="header-brand">

                <div class="header-logo">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>

                <div>

                    <h2 class="header-title">
                        TRƯỜNG ĐẠI HỌC KINH TẾ - KỸ THUẬT CÔNG NGHIỆP
                    </h2>

                    <p class="header-subtitle">
                        UNETI | HỆ THỐNG QUẢN LÝ ĐỀ TÀI ĐỒ ÁN
                    </p>

                </div>

            </div>

            <div class="header-badge">
                <i class="fa-solid fa-shield-halved"></i>
                Cổng quản lý trực tuyến
            </div>

        </div>

    </header>

    <!-- NỘI DUNG CHÍNH -->

    <main class="main-container">

        <!-- LỜI CHÀO -->

        <div class="welcome-text">

            <div class="welcome-label">
                <i class="fa-solid fa-graduation-cap"></i>
                HỆ THỐNG QUẢN LÝ ĐỒ ÁN
            </div>

            <h1>Chào mừng đến với hệ thống quản lý đề tài đồ án</h1>

            <p>
                Nền tảng hỗ trợ quản lý, đăng ký, xét duyệt và theo dõi
                quá trình thực hiện đề tài đồ án.
            </p>

        </div>

        <!-- KHUNG ẢNH + FORM -->

        <div class="portal-card">

            <!-- ẢNH TRƯỜNG BÊN TRÁI -->

            <section class="portal-banner">

                <div class="banner-content">

                    <div class="banner-tag">
                        <i class="fa-solid fa-building-columns"></i>
                        TRƯỜNG ĐẠI HỌC UNETI
                    </div>

                    <h2 class="banner-title">
                        Đồng hành cùng hành trình
                        học tập và nghiên cứu
                    </h2>

                    <p class="banner-description">
                        Kết nối sinh viên, giảng viên và nhà trường
                        trong quá trình đăng ký, quản lý và thực hiện
                        đề tài đồ án.
                    </p>

                   

                    <div class="banner-school">
                        <i class="fa-solid fa-location-dot"></i>
                        Trường Đại học Kinh tế - Kỹ thuật Công nghiệp
                    </div>

                </div>

            </section>

            <!-- FORM ĐĂNG NHẬP BÊN PHẢI -->

            <section class="login-panel">

                <div class="login-box">

                    <div class="login-heading">

                        <h2>Đăng nhập</h2>

                        <p>
                            Sử dụng tài khoản được cấp để truy cập hệ thống
                        </p>

                    </div>

                    <!-- HIỂN THỊ LỖI -->
                    @if (ViewBag.Loi != null)
                    {
                        <div class="error-box" role="alert">

                            <i class="fa-solid fa-circle-exclamation"></i>

                            <span>@ViewBag.Loi</span>

                        </div>
                    }

                    <!-- FORM -->

                    <form asp-controller="DangNhap"
                          asp-action="Index"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- TÊN ĐĂNG NHẬP -->

                        <div class="form-group">

                            <label for="tenDangNhap"
                                   class="form-label">
                                Tên đăng nhập
                            </label>

                            <div class="input-wrapper">

                                <i class="fa-regular fa-user input-icon"></i>

                                <input type="text"
                                       id="tenDangNhap"
                                       name="tenDangNhap"
                                       class="form-input"
                                       placeholder="Nhập tên đăng nhập"
                                       autocomplete="username"
                                       required />

                            </div>

                        </div>

                        <!-- MẬT KHẨU -->

                        <div class="form-group">

                            <label for="matKhau"
                                   class="form-label">
                                Mật khẩu
                            </label>

                            <div class="input-wrapper">

                                <i class="fa-solid fa-lock input-icon"></i>

                                <input type="password"
                                       id="matKhau"
                                       name="matKhau"
                                       class="form-input"
                                       placeholder="Nhập mật khẩu"
                                       autocomplete="current-password"
                                       required />

                                <button type="button"
                                        class="password-toggle"
                                        id="togglePassword"
                                        onclick="hienAnMatKhau()"
                                        aria-label="Hiện mật khẩu">

                                    <i class="fa-regular fa-eye"
                                       id="eyeIcon"></i>

                                </button>

                            </div>

                        </div>

                        <!-- GHI NHỚ -->

                        <div class="form-options">

                            <label class="remember-label">

                                <input type="checkbox"
                                       id="ghiNho"
                                       name="ghiNho"
                                       value="true" />

                                Ghi nhớ đăng nhập

                            </label>

                            <span class="secure-note">
                                <i class="fa-solid fa-lock"></i>
                                Bảo mật
                            </span>

                        </div>

                        <!-- ĐĂNG NHẬP -->

                        <button type="submit"
                                class="login-button">

                            <i class="fa-solid fa-right-to-bracket"></i>

                            Đăng nhập hệ thống

                        </button>

                    </form>

                    <div class="login-help">
                        Hệ thống dành cho quản trị viên và sinh viên UNETI
                    </div>

                </div>

            </section>

        </div>

        <!-- CÁC CHỨC NĂNG CHÍNH -->

        <h2 class="features-title">
            Các chức năng chính của hệ thống
        </h2>

        <div class="features-grid">

            <!-- QUẢN LÝ ĐỀ TÀI -->

            <div class="feature-card">

                <div class="feature-icon">
                    <i class="fa-solid fa-book-open"></i>
                </div>

                <div class="feature-info">

                    <h3>Quản lý đề tài</h3>

                    <p>
                        Quản lý thông tin đề tài và giảng viên hướng dẫn.
                    </p>

                </div>

            </div>

            <!-- ĐĂNG KÝ -->

            <div class="feature-card">

                <div class="feature-icon">
                    <i class="fa-solid fa-clipboard-check"></i>
                </div>

                <div class="feature-info">

                    <h3>Đăng ký & xét duyệt</h3>

                    <p>
                        Sinh viên đăng ký đề tài và theo dõi kết quả xét duyệt.
                    </p>

                </div>

            </div>

            <!-- TIẾN ĐỘ -->

            <div class="feature-card">

                <div class="feature-icon">
                    <i class="fa-solid fa-chart-line"></i>
                </div>

                <div class="feature-info">

                    <h3>Theo dõi tiến độ</h3>

                    <p>
                        Theo dõi phân công, tiến độ thực hiện và thống kê.
                    </p>

                </div>

            </div>

        </div>

    </main>

    <!-- FOOTER -->

    <footer class="site-footer">

        <div class="footer-container">

            <span>
                © 2026 UNETI - Hệ thống quản lý đề tài đồ án
            </span>

            <div class="footer-right">
                <i class="fa-solid fa-graduation-cap"></i>
                Trường Đại học Kinh tế - Kỹ thuật Công nghiệp
            </div>

        </div>

    </footer>

    <!-- JAVASCRIPT -->

    <script>
            function hienAnMatKhau() {

                const input =
                    document.getElementById("matKhau");

                const icon =
                    document.getElementById("eyeIcon");

                const button =
                    document.getElementById("togglePassword");

                if (input.type === "password") {

                    input.type = "text";

                    icon.className =
                        "fa-regular fa-eye-slash";

                    button.setAttribute(
                        "aria-label",
                        "Ẩn mật khẩu"
                    );

                } else {

                    input.type = "password";

                    icon.className =
                        "fa-regular fa-eye";

                    button.setAttribute(
                        "aria-label",
                        "Hiện mật khẩu"
                    );
                }
            }
    </script>

</body>
</html>
