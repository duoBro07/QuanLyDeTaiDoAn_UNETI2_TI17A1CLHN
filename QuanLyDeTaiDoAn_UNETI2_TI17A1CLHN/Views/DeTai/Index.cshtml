@model IEnumerable<QuanLyDeTaiDoAn.Models.DeTai>

@{
    ViewData["Title"] = "Quản lý đề tài";

    int trangHienTai = ViewBag.TrangHienTai ?? 1;
    int tongTrang = ViewBag.TongTrang ?? 0;
    int tongBanGhi = ViewBag.TongBanGhi ?? 0;
    int kichThuocTrang = ViewBag.KichThuocTrang ?? 10;

    int batDau = tongBanGhi == 0
        ? 0
        : (trangHienTai - 1) * kichThuocTrang + 1;

    int ketThuc = Math.Min(
        trangHienTai * kichThuocTrang,
        tongBanGhi);

    string[] trangThais =
    {
        "Mở đăng ký",
        "Đủ số lượng",
        "Tạm khóa",
        "Kết thúc"
    };

    var sapXeps = new Dictionary<string, string>
    {
        { "", "Tên A → Z" },
        { "ten_za", "Tên Z → A" },
        { "sv_tang", "Số SV tối đa tăng dần" },
        { "sv_giam", "Số SV tối đa giảm dần" },
        { "cho_tang", "Số chỗ còn tăng dần" },
        { "cho_giam", "Số chỗ còn giảm dần" }
    };

    var soDaDangKy =
        ViewBag.SoDaDangKy as Dictionary<int, int>
        ?? new Dictionary<int, int>();
}

<div class="content-card">
    <div class="p-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="page-title">Quản lý đề tài</h2>
                <small class="text-muted">
                    Danh sách đề tài đồ án
                </small>
            </div>

            <a asp-action="Create" class="btn btn-main">
                <i class="fa-solid fa-plus me-1"></i>
                Thêm đề tài
            </a>
        </div>

        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-success">
                @TempData["ThongBao"]
            </div>
        }

        @if (TempData["Loi"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Loi"]
            </div>
        }

        <form asp-action="Index" method="get">
            <div class="row g-2">
                <div class="col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>

                        <input type="text"
                               name="tuKhoa"
                               value="@ViewBag.TuKhoa"
                               class="form-control"
                               placeholder="Tìm tên hoặc mô tả đề tài..." />
                    </div>
                </div>

                <div class="col-lg-2">
                    <select name="maLinhVuc" class="form-select">
                        <option value="">Tất cả lĩnh vực</option>

                        @foreach (var lv in ViewBag.LinhVucs)
                        {
                            if (ViewBag.MaLinhVucLoc != null &&
                                (int)ViewBag.MaLinhVucLoc == lv.MaLinhVuc)
                            {
                                <option value="@lv.MaLinhVuc" selected>
                                    @lv.TenLinhVuc
                                </option>
                            }
                            else
                            {
                                <option value="@lv.MaLinhVuc">
                                    @lv.TenLinhVuc
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-lg-2">
                    <select name="namHoc" class="form-select">
                        <option value="">Tất cả năm học</option>

                        @foreach (var nam in ViewBag.NamHocs)
                        {
                            if (ViewBag.NamHocLoc == nam)
                            {
                                <option value="@nam" selected>
                                    @nam
                                </option>
                            }
                            else
                            {
                                <option value="@nam">
                                    @nam
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-lg-2">
                    <select name="hocKy" class="form-select">
                        <option value="">Tất cả học kỳ</option>

                        @for (int i = 1; i <= 3; i++)
                        {
                            if (ViewBag.HocKyLoc != null &&
                                (int)ViewBag.HocKyLoc == i)
                            {
                                <option value="@i" selected>
                                    Học kỳ @i
                                </option>
                            }
                            else
                            {
                                <option value="@i">
                                    Học kỳ @i
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-lg-2">
                    <select name="trangThai" class="form-select">
                        <option value="">Tất cả trạng thái</option>

                        @foreach (var tt in trangThais)
                        {
                            if (ViewBag.TrangThaiLoc == tt)
                            {
                                <option value="@tt" selected>
                                    @tt
                                </option>
                            }
                            else
                            {
                                <option value="@tt">
                                    @tt
                                </option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="row g-2 mt-1">
                <div class="col-lg-3">
                    <select name="choCon" class="form-select">
                        <option value="">Tất cả số chỗ</option>

                        @if (ViewBag.ChoCon == "con")
                        {
                            <option value="con" selected>
                                Còn chỗ
                            </option>
                        }
                        else
                        {
                            <option value="con">
                                Còn chỗ
                            </option>
                        }

                        @if (ViewBag.ChoCon == "het")
                        {
                            <option value="het" selected>
                                Hết chỗ
                            </option>
                        }
                        else
                        {
                            <option value="het">
                                Hết chỗ
                            </option>
                        }
                    </select>
                </div>

                <div class="col-lg-3">
                    <select name="sapXep" class="form-select">
                        @foreach (var sx in sapXeps)
                        {
                            if ((ViewBag.SapXep ?? "") == sx.Key)
                            {
                                <option value="@sx.Key" selected>
                                    @sx.Value
                                </option>
                            }
                            else
                            {
                                <option value="@sx.Key">
                                    @sx.Value
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-lg-6">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-filter me-1"></i>
                        Tìm kiếm / Lọc
                    </button>

                    <a asp-action="Index" class="btn btn-light border">
                        Đặt lại
                    </a>
                </div>
            </div>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-3">STT</th>
                    <th>Tên đề tài</th>
                    <th>Lĩnh vực</th>
                    <th>Năm học</th>
                    <th>HK</th>
                    <th class="text-center">SV tối đa</th>
                    <th class="text-center">Đã đăng ký</th>
                    <th class="text-center">Chỗ còn</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Any())
                {
                    int stt = batDau;

                    foreach (var item in Model)
                    {
                        int daDangKy = soDaDangKy.TryGetValue(
                            item.MaDeTai, out int soLuong)
                            ? soLuong
                            : 0;

                        int choCon = item.SoSinhVienToiDa - daDangKy;

                        <tr>
                            <td class="ps-3">@stt</td>

                            <td class="fw-semibold">
                                @item.TenDeTai
                            </td>

                            <td>@item.LinhVuc?.TenLinhVuc</td>
                            <td>@item.NamHoc</td>
                            <td>@item.HocKy</td>

                            <td class="text-center">
                                @item.SoSinhVienToiDa
                            </td>

                            <td class="text-center">
                                @daDangKy
                            </td>

                            <td class="text-center">
                                @if (choCon < 0)
                                {
                                    <span class="badge bg-danger">
                                        Vượt @(-choCon) chỗ
                                    </span>
                                }
                                else if (choCon == 0)
                                {
                                    <span class="badge bg-danger">
                                        Hết chỗ (0)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Còn @choCon chỗ
                                    </span>
                                }
                            </td>

                            
                            <td>
                                @if (item.TrangThai == "Tạm khóa")
                                {
                                    <span class="status-stop">
                                        Tạm khóa
                                    </span>
                                }
                                else if (item.TrangThai == "Kết thúc")
                                {
                                    <span class="badge bg-secondary">
                                        Kết thúc
                                    </span>
                                }
                                else if (choCon <= 0)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Đủ số lượng
                                    </span>
                                }
                                else
                                {
                                    <span class="status-active">
                                        Mở đăng ký
                                    </span>
                                }
                            </td>


                            <td class="text-center text-nowrap">
                                <a asp-action="Edit"
                                   asp-route-id="@item.MaDeTai"
                                   class="action-btn action-edit"
                                   title="Sửa">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>

                                <a asp-action="Details"
                                   asp-route-id="@item.MaDeTai"
                                   class="action-btn action-info"
                                   title="Chi tiết">
                                    <i class="fa-solid fa-circle-info"></i>
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.MaDeTai"
                                   class="action-btn action-delete"
                                   title="Xóa">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>

                        stt++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10"
                            class="text-center text-muted py-5">
                            Không tìm thấy đề tài.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center p-3 border-top flex-wrap gap-2">
        <nav>
            @if (tongTrang > 0)
            {
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(trangHienTai <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-trang="@(trangHienTai - 1)"
                           asp-route-tuKhoa="@ViewBag.TuKhoa"
                           asp-route-maLinhVuc="@ViewBag.MaLinhVucLoc"
                           asp-route-namHoc="@ViewBag.NamHocLoc"
                           asp-route-hocKy="@ViewBag.HocKyLoc"
                           asp-route-trangThai="@ViewBag.TrangThaiLoc"
                           asp-route-sapXep="@ViewBag.SapXep"
                           asp-route-choCon="@ViewBag.ChoCon">
                            ‹
                        </a>
                    </li>

                    @for (int i = 1; i <= tongTrang; i++)
                    {
                        <li class="page-item @(i == trangHienTai ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-trang="@i"
                               asp-route-tuKhoa="@ViewBag.TuKhoa"
                               asp-route-maLinhVuc="@ViewBag.MaLinhVucLoc"
                               asp-route-namHoc="@ViewBag.NamHocLoc"
                               asp-route-hocKy="@ViewBag.HocKyLoc"
                               asp-route-trangThai="@ViewBag.TrangThaiLoc"
                               asp-route-sapXep="@ViewBag.SapXep"
                               asp-route-choCon="@ViewBag.ChoCon">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(trangHienTai >= tongTrang ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-trang="@(trangHienTai + 1)"
                           asp-route-tuKhoa="@ViewBag.TuKhoa"
                           asp-route-maLinhVuc="@ViewBag.MaLinhVucLoc"
                           asp-route-namHoc="@ViewBag.NamHocLoc"
                           asp-route-hocKy="@ViewBag.HocKyLoc"
                           asp-route-trangThai="@ViewBag.TrangThaiLoc"
                           asp-route-sapXep="@ViewBag.SapXep"
                           asp-route-choCon="@ViewBag.ChoCon">
                            ›
                        </a>
                    </li>
                </ul>
            }
        </nav>

        <small class="text-muted">
            Hiển thị @batDau - @ketThuc
            trong @tongBanGhi kết quả
        </small>
    </div>
</div>
