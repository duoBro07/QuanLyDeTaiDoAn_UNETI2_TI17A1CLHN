@model QuanLyDeTaiDoAn.Models.DeTai

@{
    ViewData["Title"] = "Chi tiết đề tài";
}

<div class="content-card">

    <div class="p-4">

        <div class="d-flex justify-content-between
            align-items-center mb-4">

            <h2 class="page-title">
                Chi tiết đề tài
            </h2>

            <span class="badge bg-primary">
                @Model.TrangThai
            </span>

        </div>

        <div class="row g-3">

            <div class="col-md-6">
                <div class="text-muted small">
                    Mã đề tài
                </div>

                <div class="fw-semibold">
                    @Model.MaDeTai
                </div>
            </div>

            <div class="col-md-6">
                <div class="text-muted small">
                    Tên đề tài
                </div>

                <div class="fw-semibold">
                    @Model.TenDeTai
                </div>
            </div>

            <div class="col-md-6">
                <div class="text-muted small">
                    Lĩnh vực
                </div>

                <div>
                    @Model.LinhVuc?.TenLinhVuc
                </div>
            </div>

            <div class="col-md-6">
                <div class="text-muted small">
                    Số sinh viên tối đa
                </div>

                <div>
                    @Model.SoSinhVienToiDa
                </div>
            </div>

            <div class="col-md-6">
                <div class="text-muted small">
                    Năm học
                </div>

                <div>
                    @Model.NamHoc
                </div>
            </div>

            <div class="col-md-6">
                <div class="text-muted small">
                    Học kỳ
                </div>

                <div>
                    @Model.HocKy
                </div>
            </div>

            <div class="col-12">
                <hr />

                <div class="text-muted small mb-1">
                    Mô tả
                </div>

                <div>
                    @(string.IsNullOrWhiteSpace(Model.MoTa)
                        ? "Chưa có mô tả"
                        : Model.MoTa)
                </div>
            </div>

            <div class="col-12">

                <div class="text-muted small mb-1">
                    Yêu cầu
                </div>

                <div>
                    @(string.IsNullOrWhiteSpace(Model.YeuCau)
                        ? "Chưa có yêu cầu"
                        : Model.YeuCau)
                </div>

            </div>

        </div>

        <div class="d-flex justify-content-end
            gap-2 mt-4 pt-3 border-top">

            <a asp-action="Index"
               class="btn btn-light border">
                Quay lại
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.MaDeTai"
               class="btn btn-primary">

                <i class="fa-solid
                    fa-pen-to-square me-1">
                </i>

                Sửa

            </a>

        </div>

    </div>
</div>