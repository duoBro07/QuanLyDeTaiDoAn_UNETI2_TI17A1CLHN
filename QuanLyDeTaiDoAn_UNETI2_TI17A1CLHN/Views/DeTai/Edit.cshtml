@model QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models.DeTai

@{
    ViewData["Title"] = "Chỉnh sửa đề tài";
}

<div class="content-card">
    <div class="p-3 p-lg-4">

        <div class="mb-4">
            <h2 class="page-title mb-1">
                <i class="fa-solid fa-pen me-2"></i>
                Chỉnh sửa đề tài
            </h2>
            <p class="page-description mb-0">
                Cập nhật thông tin đề tài đồ án
            </p>
        </div>

        <form asp-controller="DeTai"
              asp-action="Edit"
              asp-route-id="@Model.MaDeTai"
              method="post"
              id="formSuaDeTai">

            @Html.AntiForgeryToken()
            <input asp-for="MaDeTai" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row g-3">

                <div class="col-md-4">
                    <label class="form-label">Mã đề tài</label>
                    <input class="form-control"
                           value="@Model.MaDeTai"
                           readonly />
                </div>

                <div class="col-md-8">
                    <label asp-for="TenDeTai" class="form-label">
                        Tên đề tài <span class="text-danger">*</span>
                    </label>
                    <input asp-for="TenDeTai" class="form-control" />
                    <span asp-validation-for="TenDeTai"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="MaLinhVuc" class="form-label">
                        Lĩnh vực <span class="text-danger">*</span>
                    </label>
                    <select asp-for="MaLinhVuc"
                            asp-items="ViewBag.MaLinhVuc"
                            class="form-select">
                        <option value="0">-- Chọn lĩnh vực --</option>
                    </select>
                    <span asp-validation-for="MaLinhVuc"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SoSinhVienToiDa" class="form-label">
                        Số sinh viên tối đa
                        <span class="text-danger">*</span>
                    </label>
                    <input asp-for="SoSinhVienToiDa"
                           type="number"
                           min="1"
                           class="form-control" />
                    <span asp-validation-for="SoSinhVienToiDa"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="NamHoc" class="form-label">
                        Năm học <span class="text-danger">*</span>
                    </label>
                    <input asp-for="NamHoc" class="form-control" />
                    <span asp-validation-for="NamHoc"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="HocKy" class="form-label">
                        Học kỳ <span class="text-danger">*</span>
                    </label>
                    <select asp-for="HocKy" class="form-select">
                        <option value="1">Học kỳ 1</option>
                        <option value="2">Học kỳ 2</option>
                        <option value="3">Học kỳ 3</option>
                    </select>
                    <span asp-validation-for="HocKy"
                          class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="MoTa" class="form-label">Mô tả</label>
                    <textarea asp-for="MoTa"
                              class="form-control"
                              rows="4"></textarea>
                    <span asp-validation-for="MoTa"
                          class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="YeuCau" class="form-label">Yêu cầu</label>
                    <textarea asp-for="YeuCau"
                              class="form-control"
                              rows="4"></textarea>
                    <span asp-validation-for="YeuCau"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="TrangThai" class="form-label">
                        Trạng thái <span class="text-danger">*</span>
                    </label>
                    <select asp-for="TrangThai" class="form-select">
                        <option value="Mở đăng ký">Mở đăng ký</option>
                        <option value="Đủ số lượng">Đủ số lượng</option>
                        <option value="Tạm khóa">Tạm khóa</option>
                        <option value="Kết thúc">Kết thúc</option>
                    </select>
                    <span asp-validation-for="TrangThai"
                          class="text-danger"></span>
                </div>

            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2 flex-wrap">
                <a asp-controller="DeTai"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left"></i>
                    Quay lại
                </a>

                <button type="button"
                        id="btnMoSuaDeTai"
                        class="btn btn-main">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Cập nhật đề tài
                </button>
            </div>

        </form>
    </div>
</div>

<!-- XAC NHAN CAP NHAT -->

<div class="modal fade"
     id="modalSuaDeTai"
     tabindex="-1"
     aria-labelledby="tieuDeSuaDeTai"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="tieuDeSuaDeTai">
                    <i class="fa-solid fa-circle-question me-2"></i>
                    Xác nhận cập nhật
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Đóng"></button>
            </div>

            <div class="modal-body">
                Bạn có chắc chắn muốn cập nhật thông tin
                đề tài <strong>@Model.TenDeTai</strong> không?
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Hủy
                </button>

                <button type="button"
                        id="btnXacNhanSuaDeTai"
                        class="btn btn-main">
                    <i class="fa-solid fa-check"></i>
                    Xác nhận
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("formSuaDeTai");
            const btnMo = document.getElementById("btnMoSuaDeTai");
            const btnXacNhan = document.getElementById("btnXacNhanSuaDeTai");
            const modalElement = document.getElementById("modalSuaDeTai");

            if (!form || !btnMo || !btnXacNhan || !modalElement) {
                return;
            }

            btnMo.addEventListener("click", function () {
                if (window.jQuery &&
                    typeof window.jQuery.fn.valid === "function") {
                    if (!window.jQuery(form).valid()) {
                        return;
                    }
                } else if (!form.reportValidity()) {
                    return;
                }

                bootstrap.Modal.getOrCreateInstance(modalElement).show();
            });

            btnXacNhan.addEventListener("click", function () {
                btnXacNhan.disabled = true;
                form.requestSubmit();
            });
        });
    </script>
}
