@model IEnumerable<QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models.DangKyDeTai>
@using QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models

@{
    ViewData["Title"] = "Duyệt đăng ký";
    ViewData["UnifiedIndex"] = true;

    string tuKhoa = ViewBag.TuKhoa as string ?? "";
    string trangThai = ViewBag.TrangThai as string ?? "";
    int? maLinhVuc = ViewBag.MaLinhVuc as int?;

    var linhVucs = ViewBag.LinhVucs as IEnumerable<LinhVuc>
        ?? Enumerable.Empty<LinhVuc>();

    int tong = ViewBag.TongDangKy ?? 0;
    int choDuyet = ViewBag.ChoDuyet ?? 0;
    int daDuyet = ViewBag.DaDuyet ?? 0;
    int tuChoi = ViewBag.TuChoi ?? 0;
    int daHuy = ViewBag.DaHuy ?? 0;

    var danhSach = Model?.ToList() ?? new List<DangKyDeTai>();
}

<div class="content-card">
    <div class="p-3 p-lg-4">

        <div class="mb-4">
            <h2 class="page-title mb-1">
                <i class="fa-solid fa-clipboard-check me-2"></i>
                Duyệt đăng ký đề tài
            </h2>
            <p class="page-description mb-0">
                Tiếp nhận, kiểm tra và xử lý hồ sơ đăng ký của sinh viên
            </p>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <i class="fa-solid fa-circle-exclamation me-2"></i>
                @TempData["Error"]
            </div>
        }

        <div class="row g-3 mb-4">
            <div class="col-6 col-lg">
                <div class="uneti-card h-100">
                    <div class="uneti-card-body">
                        <div class="text-muted small">Tổng đăng ký</div>
                        <div class="fs-3 fw-bold text-primary">@tong</div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="uneti-card h-100">
                    <div class="uneti-card-body">
                        <div class="text-muted small">Chờ duyệt</div>
                        <div class="fs-3 fw-bold text-warning">@choDuyet</div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="uneti-card h-100">
                    <div class="uneti-card-body">
                        <div class="text-muted small">Đã duyệt</div>
                        <div class="fs-3 fw-bold text-success">@daDuyet</div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="uneti-card h-100">
                    <div class="uneti-card-body">
                        <div class="text-muted small">Từ chối</div>
                        <div class="fs-3 fw-bold text-danger">@tuChoi</div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-lg">
                <div class="uneti-card h-100">
                    <div class="uneti-card-body">
                        <div class="text-muted small">Đã hủy</div>
                        <div class="fs-3 fw-bold text-secondary">@daHuy</div>
                    </div>
                </div>
            </div>
        </div>

        <form asp-controller="DuyetDangKy"
              asp-action="Index"
              method="get"
              class="uneti-filter-bar">

            <div class="row g-3">

                <div class="col-lg-4">
                    <label for="tuKhoa" class="form-label">
                        Tìm kiếm
                    </label>
                    <input id="tuKhoa"
                           name="tuKhoa"
                           value="@tuKhoa"
                           class="form-control"
                           placeholder="Tên sinh viên, mã SV, tên đề tài..." />
                </div>

                <div class="col-lg-3">
                    <label for="trangThai" class="form-label">
                        Trạng thái
                    </label>
                    <select id="trangThai"
                            name="trangThai"
                            class="form-select">
                        <option value="">Tất cả trạng thái</option>
                        @foreach (var tt in new[] {
                            "Chờ duyệt", "Đã duyệt", "Từ chối", "Đã hủy"
                        })
                        {
                            <option value="@tt" selected="@(trangThai == tt)">
                                @tt
                            </option>
                        }
                    </select>
                </div>

                <div class="col-lg-3">
                    <label for="maLinhVuc" class="form-label">
                        Lĩnh vực
                    </label>
                    <select id="maLinhVuc"
                            name="maLinhVuc"
                            class="form-select">
                        <option value="">Tất cả lĩnh vực</option>
                        @foreach (var lv in linhVucs)
                        {
                            <option value="@lv.MaLinhVuc"
                                    selected="@(maLinhVuc == lv.MaLinhVuc)">
                                @lv.TenLinhVuc
                            </option>
                        }
                    </select>
                </div>

                <div class="col-lg-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-main flex-fill">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        Lọc
                    </button>
                    <a asp-action="Index"
                       class="btn btn-outline-secondary"
                       title="Đặt lại">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                </div>
            </div>
        </form>

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="fw-bold mb-0" style="color:#17477e">
                <i class="fa-solid fa-list me-2"></i>
                Danh sách hồ sơ (@danhSach.Count)
            </h5>
            <span class="text-muted small">
                Sắp xếp theo ngày đăng ký mới nhất
            </span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table uneti-table table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-3">STT</th>
                    <th>Mã ĐK</th>
                    <th>Sinh viên</th>
                    <th>Lớp</th>
                    <th>Đề tài</th>
                    <th>Ngày đăng ký</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (danhSach.Any())
                {
                    int stt = 0;
                    foreach (var item in danhSach)
                    {
                        stt++;

                        string lopTrangThai = item.TrangThai switch
                        {
                            "Đã duyệt" => "uneti-status-success",
                            "Chờ duyệt" => "uneti-status-warning",
                            "Từ chối" => "uneti-status-danger",
                            _ => "uneti-status-info"
                        };

                        <tr>
                            <td class="ps-3">@stt</td>
                            <td>@item.MaDangKy</td>
                            <td>
                                <div class="fw-semibold">
                                    @(item.SinhVien?.HoTen ?? "Không có thông tin")
                                </div>
                                <small class="text-muted">
                                    Mã SV: @item.MaSinhVien
                                </small>
                            </td>
                            <td>@(item.SinhVien?.Lop ?? "—")</td>
                            <td class="fw-semibold">
                                @(item.DeTai?.TenDeTai ?? "Không có thông tin")
                            </td>
                            <td>@item.NgayDangKy.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-center">
                                <span class="uneti-status @lopTrangThai">
                                    @item.TrangThai
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="uneti-actions">
                                    <a asp-controller="DuyetDangKy"
                                       asp-action="Details"
                                       asp-route-id="@item.MaDangKy"
                                       class="btn btn-outline-primary btn-sm"
                                       title="Xem và xử lý hồ sơ">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>

                                    @if (item.TrangThai == "Chờ duyệt")
                                    {
                                        <a asp-controller="DuyetDangKy"
                                           asp-action="Details"
                                           asp-route-id="@item.MaDangKy"
                                           class="btn btn-outline-primary btn-sm"
                                           title="Duyệt hoặc từ chối">
                                            <i class="fa-solid fa-clipboard-check"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-5">
                            <i class="fa-solid fa-inbox fa-2x d-block mb-3"></i>
                            Không có hồ sơ đăng ký phù hợp.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="p-3 border-top text-muted small">
        Hiển thị <strong>@danhSach.Count</strong> hồ sơ theo bộ lọc hiện tại.
    </div>
</div>
