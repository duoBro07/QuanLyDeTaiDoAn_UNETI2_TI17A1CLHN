@{
    ViewData["Title"] = "Chưa có hồ sơ sinh viên";
}

<div class="content-card">
    <div class="p-3 p-lg-4">

        <div class="text-center py-4">

            <div class="mb-4">
                <i class="fa-solid fa-user-slash text-warning"
                   style="font-size:56px"></i>
            </div>

            <h2 class="page-title mb-3">
                Chưa có hồ sơ sinh viên
            </h2>

            <p class="page-description mx-auto mb-4"
               style="max-width:600px">
                Tài khoản của bạn chưa được liên kết với hồ sơ sinh viên
                trong hệ thống. Bạn cần có hồ sơ hợp lệ để đăng ký đề tài
                và theo dõi giảng viên hướng dẫn.
            </p>

            <div class="alert alert-warning text-start mx-auto"
                 style="max-width:600px">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                <strong>Cần quản trị viên kiểm tra:</strong>

                <ol class="mb-0 mt-2">
                    <li>Tài khoản đã được tạo và có vai trò Sinh viên.</li>
                    <li>Hồ sơ sinh viên đã tồn tại trong hệ thống.</li>
                    <li>Mã tài khoản của hồ sơ trùng với tài khoản đang đăng nhập.</li>
                    <li>Hồ sơ sinh viên đang ở trạng thái hoạt động.</li>
                </ol>
            </div>

            <div class="d-flex justify-content-center gap-2 flex-wrap mt-4">
                <a asp-controller="CongSinhVien"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Quay lại trang chủ
                </a>

                <a asp-controller="CongSinhVien"
                   asp-action="HoSo"
                   class="btn btn-main">
                    <i class="fa-solid fa-rotate me-1"></i>
                    Kiểm tra lại hồ sơ
                </a>
            </div>

        </div>

    </div>
</div>
