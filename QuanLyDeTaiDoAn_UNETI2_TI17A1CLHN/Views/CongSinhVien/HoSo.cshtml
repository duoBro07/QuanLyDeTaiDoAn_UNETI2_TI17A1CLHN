@model QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models.SinhVien

@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="content-card">
    <div class="p-3 p-lg-4">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h2 class="page-title mb-1">
                    <i class="fa-solid fa-id-card me-2"></i>
                    Thông tin cá nhân
                </h2>

                <p class="page-description mb-0">
                    Hồ sơ sinh viên được quản lý bởi nhà trường
                </p>
            </div>

            <span class="uneti-status uneti-status-info">
                <i class="fa-solid fa-eye me-1"></i>
                Chỉ xem
            </span>
        </div>

        <h5 class="fw-bold text-primary mb-3">
            <i class="fa-solid fa-user-graduate me-2"></i>
            Thông tin sinh viên
        </h5>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Mã sinh viên</div>
            <div class="uneti-details-value">
                @Model.MaSinhVien
            </div>
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Họ và tên</div>
            <div class="uneti-details-value fw-semibold">
                @Model.HoTen
            </div>
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Ngày sinh</div>
            <div class="uneti-details-value">
                @Model.NgaySinh.ToString("dd/MM/yyyy")
            </div>
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Lớp</div>
            <div class="uneti-details-value">
                @Model.Lop
            </div>
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Khoa</div>
            <div class="uneti-details-value">
                @Model.Khoa
            </div>
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Chuyên ngành</div>
            <div class="uneti-details-value">
                @Model.ChuyenNganh
            </div>
        </div>

        <hr class="my-4" />

        <h5 class="fw-bold text-primary mb-3">
            <i class="fa-solid fa-address-book me-2"></i>
            Thông tin liên hệ
        </h5>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Email</div>
            <div class="uneti-details-value">
                @Model.Email
            </div>
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Số điện thoại</div>
            <div class="uneti-details-value">
                @(string.IsNullOrWhiteSpace(Model.SoDienThoai)
                    ? "Chưa cập nhật"
                    : Model.SoDienThoai)
            </div>
        </div>

        <hr class="my-4" />

        <h5 class="fw-bold text-primary mb-3">
            <i class="fa-solid fa-shield-halved me-2"></i>
            Thông tin tài khoản
        </h5>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Mã tài khoản</div>
            <div class="uneti-details-value">
                @Model.MaTaiKhoan
            </div>
        </div>

        <div class="uneti-details-row">
            <div class="uneti-details-label">Trạng thái hồ sơ</div>
            <div class="uneti-details-value">
                @if (Model.TrangThai)
                {
                    <span class="uneti-status uneti-status-success">
                        <i class="fa-solid fa-circle-check me-1"></i>
                        Hoạt động
                    </span>
                }
                else
                {
                    <span class="uneti-status uneti-status-danger">
                        <i class="fa-solid fa-lock me-1"></i>
                        Đã khóa
                    </span>
                }
            </div>
        </div>

        <div class="alert alert-info mt-4">
            <i class="fa-solid fa-circle-info me-2"></i>
            Nếu thông tin cá nhân chưa chính xác, vui lòng liên hệ
            quản trị viên để được cập nhật. Sinh viên không thể
            tự chỉnh sửa hồ sơ tại trang này.
        </div>

        <div class="d-flex justify-content-end gap-2 flex-wrap">
            <a asp-controller="CongSinhVien"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>
                Quay lại trang chủ
            </a>

            <a asp-controller="DangKyDeTai"
               asp-action="Index"
               class="btn btn-main">
                <i class="fa-solid fa-clipboard-list me-1"></i>
                Đăng ký của tôi
            </a>
        </div>

    </div>
</div>
