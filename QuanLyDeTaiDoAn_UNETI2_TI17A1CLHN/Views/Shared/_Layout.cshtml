@{
    var maTaiKhoan = Context.Session.GetInt32("MaTaiKhoan");
    var hoTen = Context.Session.GetString("HoTen") ?? "Người dùng";
    var vaiTro = Context.Session.GetString("VaiTro") ?? string.Empty;
    bool laAdmin = vaiTro == "Admin";
    var tenVietTat = string.IsNullOrWhiteSpace(hoTen) ? "U" : hoTen.Trim()[0].ToString().ToUpper();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý đề tài đồ án</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (maTaiKhoan == null)
{
    @RenderBody()
}
else
{
    <div class="app-shell">
        <aside class="app-sidebar">
            <div class="sidebar-brand">
                <div class="brand-logo">🎓</div>
                <div>
                    <div class="brand-name">QL Đề tài</div>
                    <div class="brand-sub">UNETI</div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-caption">TỔNG QUAN</div>
                <a asp-controller="Home" asp-action="Index" class="sidebar-item">
                    <span class="sidebar-icon">⌂</span><span>Trang chủ</span>
                </a>

                @if (laAdmin)
                {
                    <div class="nav-caption">MODULE 1</div>
                    <a asp-controller="TaiKhoan" asp-action="Index" class="sidebar-item">
                        <span class="sidebar-icon">♙</span><span>Tài khoản</span>
                    </a>
                    <a asp-controller="LinhVuc" asp-action="Index" class="sidebar-item">
                        <span class="sidebar-icon">▦</span><span>Lĩnh vực đề tài</span>
                    </a>

                    <div class="nav-caption">TÍCH HỢP</div>
                    <span class="sidebar-item sidebar-disabled" title="Sẽ kích hoạt sau khi merge Module 2">
                        <span class="sidebar-icon">◫</span><span>Giảng viên / Đề tài</span>
                    </span>
                }
                else
                {
                    <div class="nav-caption">SINH VIÊN</div>
                    <span class="sidebar-item sidebar-disabled">
                        <span class="sidebar-icon">⌕</span><span>Tra cứu đề tài (M2)</span>
                    </span>
                    <span class="sidebar-item sidebar-disabled">
                        <span class="sidebar-icon">✎</span><span>Đăng ký đề tài (M3)</span>
                    </span>
                }
            </nav>

            <div class="sidebar-bottom">
                <div class="sidebar-user">
                    <div class="sidebar-avatar">@tenVietTat</div>
                    <div>
                        <div class="sidebar-user-name">@hoTen</div>
                        <div class="sidebar-user-role">@(laAdmin ? "Quản trị viên" : "Sinh viên")</div>
                    </div>
                </div>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div>
                    <div class="topbar-caption">HỆ THỐNG QUẢN LÝ ĐỀ TÀI ĐỒ ÁN</div>
                    <h5 class="topbar-title">@ViewData["Title"]</h5>
                </div>
                <div class="topbar-right">
                    <div class="topbar-user">
                        <div class="top-avatar">@tenVietTat</div>
                        <div class="top-user-info"><strong>@hoTen</strong><small>@(laAdmin ? "Admin" : "Sinh viên")</small></div>
                    </div>
                    <form asp-controller="TaiKhoan" asp-action="Logout" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn đăng xuất?');">
                        <button class="logout-btn" type="submit">Đăng xuất</button>
                    </form>
                </div>
            </header>

            <main class="app-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
