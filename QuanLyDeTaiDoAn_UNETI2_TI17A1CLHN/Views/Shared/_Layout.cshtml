@using Microsoft.AspNetCore.Http

@{
    string currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string currentAction =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string vaiTro =
        (Context.Session.GetString("VaiTro") ?? "").Trim();

    string hoTen =
        Context.Session.GetString("HoTen")
        ?? Context.Session.GetString("TenDangNhap")
        ?? "Người dùng";

    bool laAdmin = vaiTro.Equals(
        "Admin", StringComparison.OrdinalIgnoreCase);

    bool laSinhVien = vaiTro.Equals(
        "SinhVien", StringComparison.OrdinalIgnoreCase);

    bool daDangNhap =
        Context.Session.GetInt32("MaTaiKhoan").HasValue
        && (laAdmin || laSinhVien);

    string Active(string tenController)
    {
        return currentController.Equals(
            tenController,
            StringComparison.OrdinalIgnoreCase)
            ? "active" : "";
    }

    string ActiveAction(string tenController, string tenAction)
    {
        return currentController.Equals(
            tenController,
            StringComparison.OrdinalIgnoreCase)
            && currentAction.Equals(
                tenAction,
                StringComparison.OrdinalIgnoreCase)
            ? "active" : "";
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - UNETI</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- DUNG LAI CSS CHUNG CUA DU AN -->
    <link rel="stylesheet"
          href="~/css/uneti-common.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/confirm-modal.css"
          asp-append-version="true" />

    <style>
            :root {
                --uneti-navy: #142f50;
                --uneti-blue: #1d5389;
                --uneti-bg: #f3f6fa;
                --uneti-header-height: 76px;
                --uneti-sidebar-width: 280px;
            }

            * {
                box-sizing: border-box;
            }

            html, body {
                margin: 0;
                min-height: 100%;
                font-family: "Segoe UI", Arial, sans-serif;
                background: var(--uneti-bg);
            }

            /* HEADER */

            .uneti-header {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                height: var(--uneti-header-height);
                background: #1b548f;
                color: white;
                z-index: 1050;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 26px;
                box-shadow: 0 2px 10px rgba(0,0,0,.08);
            }

            .uneti-header-title {
                font-size: 21px;
                font-weight: 750;
                color: white;
                text-decoration: none;
            }

                .uneti-header-title:hover {
                    color: white;
                }

            .uneti-header-actions {
                display: flex;
                align-items: center;
                gap: 18px;
            }

            .uneti-user {
                font-size: 14px;
                color: #f0f5fa;
                white-space: nowrap;
            }

            .uneti-logout {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                border: 1px solid rgba(255,255,255,.65);
                border-radius: 8px;
                padding: 9px 14px;
                color: white;
                font-size: 13px;
                font-weight: 600;
                background: transparent;
                cursor: pointer;
            }

                .uneti-logout:hover {
                    background: rgba(255,255,255,.12);
                    color: white;
                }

            .uneti-mobile-toggle {
                display: none;
                border: 0;
                background: transparent;
                color: white;
                font-size: 20px;
            }

            /* SIDEBAR */

            .uneti-sidebar {
                position: fixed;
                top: var(--uneti-header-height);
                left: 0;
                bottom: 0;
                width: var(--uneti-sidebar-width);
                background: var(--uneti-navy);
                color: white;
                display: flex;
                flex-direction: column;
                overflow: hidden;
                z-index: 1040;
                transition: transform .2s ease;
            }

            .sidebar-brand {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 22px 19px 18px;
                border-bottom: 1px solid rgba(255,255,255,.1);
            }

            .sidebar-brand-icon {
                width: 42px;
                height: 42px;
                border-radius: 11px;
                background: #315c83;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 19px;
                flex-shrink: 0;
            }

            .sidebar-brand-name {
                font-size: 19px;
                font-weight: 800;
                letter-spacing: .6px;
            }

            .sidebar-brand-subtitle {
                font-size: 9px;
                color: #b9cbdc;
                letter-spacing: .6px;
                margin-top: 3px;
            }

            .sidebar-navigation {
                flex: 1;
                overflow-y: auto;
                padding: 12px;
                scrollbar-width: thin;
                scrollbar-color: #476783 transparent;
            }

            .sidebar-group-title {
                padding: 20px 12px 9px;
                color: #91abc2;
                font-size: 10px;
                font-weight: 750;
                letter-spacing: 1.2px;
            }

                .sidebar-group-title:first-child {
                    padding-top: 8px;
                }

            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 13px;
                min-height: 44px;
                padding: 11px 14px;
                margin: 3px 0;
                border-radius: 9px;
                color: #d7e3ee;
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                transition: background .18s, color .18s;
            }

                .sidebar-link i {
                    width: 20px;
                    text-align: center;
                    font-size: 16px;
                    color: #b7cde0;
                    flex-shrink: 0;
                }

                .sidebar-link:hover {
                    background: #24496e;
                    color: white;
                }

                    .sidebar-link:hover i {
                        color: white;
                    }

                .sidebar-link.active {
                    background: #315c83;
                    color: white;
                    font-weight: 650;
                    box-shadow: inset 3px 0 0 #9fc7e6;
                }

                    .sidebar-link.active i {
                        color: white;
                    }

            .sidebar-footer {
                padding: 16px 20px;
                border-top: 1px solid rgba(255,255,255,.1);
                color: #9fb6cb;
                font-size: 12px;
            }

            /* MAIN */

            .uneti-main {
                margin-left: var(--uneti-sidebar-width);
                margin-top: var(--uneti-header-height);
                padding: 30px 32px;
                min-height: calc(100vh - var(--uneti-header-height));
                width: calc(100% - var(--uneti-sidebar-width));
                background: var(--uneti-bg);
            }

            .uneti-main-inner {
                max-width: 1600px;
                margin: 0 auto;
            }

            /* TRANG CHUA DANG NHAP */

            .uneti-main.no-sidebar {
                margin-left: 0;
                width: 100%;
            }

            /* MOBILE */

            @@media (max-width: 991px) {
                .uneti-mobile-toggle {
                    display: inline-block;
                }

                .uneti-header {
                    padding: 0 16px;
                }

                .uneti-header-title {
                    font-size: 16px;
                }

                .uneti-sidebar {
                    transform: translateX(-100%);
                }

                    .uneti-sidebar.show {
                        transform: translateX(0);
                    }

                .uneti-main {
                    margin-left: 0;
                    width: 100%;
                    padding: 20px 16px;
                }

                .uneti-user {
                    display: none;
                }
            }

            @@media (max-width: 520px) {
                .uneti-header-title {
                    font-size: 13px;
                }

                .uneti-header-actions {
                    gap: 8px;
                }

                .uneti-logout {
                    padding: 8px 10px;
                    font-size: 12px;
                }
            }

            @@media print {
                .uneti-header,
                .uneti-sidebar {
                    display: none !important;
                }

                .uneti-main {
                    margin: 0 !important;
                    padding: 0 !important;
                    width: 100% !important;
                    min-height: 0 !important;
                    background: white !important;
                }

                .uneti-main-inner {
                    max-width: none !important;
                }
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- HEADER -->
    <header class="uneti-header">

        <div class="d-flex align-items-center gap-3">

            <button type="button"
                    class="uneti-mobile-toggle"
                    id="sidebarToggle"
                    aria-label="Mở menu"
                    aria-controls="unetiSidebar"
                    aria-expanded="false">
                <i class="fa-solid fa-bars"></i>
            </button>

            <a asp-controller="Home"
               asp-action="Index"
               class="uneti-header-title">
                UNETI | Quản lý đề tài đồ án
            </a>

        </div>

        <div class="uneti-header-actions">

            @if (daDangNhap)
            {
                <div class="uneti-user">
                    <i class="fa-solid fa-user me-2"></i>
                    @hoTen
                </div>

                <form asp-controller="DangNhap"
                      asp-action="DangXuat"
                      method="post"
                      class="m-0">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="uneti-logout">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        Đăng xuất
                    </button>
                </form>
            }
            else
            {
                <a asp-controller="DangNhap"
                   asp-action="Index"
                   class="uneti-logout text-decoration-none">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    Đăng nhập
                </a>
            }

        </div>
    </header>

    <!-- SIDEBAR -->
    @if (daDangNhap)
    {
        <aside class="uneti-sidebar" id="unetiSidebar">

            <div class="sidebar-brand">
                <div class="sidebar-brand-icon">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>

                <div>
                    <div class="sidebar-brand-name">UNETI</div>
                    <div class="sidebar-brand-subtitle">
                        QUẢN LÝ ĐỀ TÀI ĐỒ ÁN
                    </div>
                </div>
            </div>

            <nav class="sidebar-navigation">

                @if (laSinhVien)
                {
                    <!-- CỔNG SINH VIÊN -->

                    <div class="sidebar-group-title">
                        CỔNG SINH VIÊN
                    </div>

                    <!-- TRANG CHỦ SINH VIÊN -->
                    <a asp-controller="CongSinhVien"
                       asp-action="Index"
                       class="sidebar-link @ActiveAction("CongSinhVien", "Index")">
                        <i class="fa-solid fa-house"></i>
                        <span>Trang chủ sinh viên</span>
                    </a>

                    <!-- DANH SÁCH ĐỀ TÀI -->
                    <a asp-controller="CongSinhVien"
                       asp-action="DeTai"
                       class="sidebar-link @ActiveAction("CongSinhVien", "DeTai")">
                        <i class="fa-solid fa-book-open"></i>
                        <span>Danh sách đề tài</span>
                    </a>

                    <!-- ĐĂNG KÝ CỦA TÔI -->
                    <a asp-controller="DangKyDeTai"
                       asp-action="Index"
                       class="sidebar-link @ActiveAction("DangKyDeTai", "Index")">
                        <i class="fa-solid fa-clipboard-list"></i>
                        <span>Đăng ký của tôi</span>
                    </a>

                    <!-- HỒ SƠ CÁ NHÂN -->
                    <a asp-controller="CongSinhVien"
                       asp-action="HoSo"
                       class="sidebar-link @ActiveAction("CongSinhVien", "HoSo")">
                        <i class="fa-solid fa-id-card"></i>
                        <span>Hồ sơ cá nhân</span>
                    </a>

                    <!-- GIẢNG VIÊN HƯỚNG DẪN -->
                    <a asp-controller="CongSinhVien"
                       asp-action="PhanCongCuaToi"
                       class="sidebar-link @ActiveAction("CongSinhVien", "PhanCongCuaToi")">
                        <i class="fa-solid fa-chalkboard-user"></i>
                        <span>Giảng viên hướng dẫn</span>
                    </a>
                }
                else if (laAdmin)
                {
                    <!-- ADMIN -->

                    <div class="sidebar-group-title">
                        TỔNG QUAN
                    </div>

                    <!-- TRANG CHỦ ADMIN -->
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="sidebar-link @Active("Home")">
                        <i class="fa-solid fa-house"></i>
                        <span>Trang chủ</span>
                    </a>

                    <div class="sidebar-group-title">
                        QUẢN LÝ HỆ THỐNG
                    </div>

                    <!-- TÀI KHOẢN -->
                    <a asp-controller="TaiKhoan"
                       asp-action="Index"
                       class="sidebar-link @Active("TaiKhoan")">
                        <i class="fa-solid fa-users-gear"></i>
                        <span>Tài khoản</span>
                    </a>

                    <!-- LĨNH VỰC -->
                    <a asp-controller="LinhVuc"
                       asp-action="Index"
                       class="sidebar-link @Active("LinhVuc")">
                        <i class="fa-solid fa-layer-group"></i>
                        <span>Lĩnh vực đề tài</span>
                    </a>

                    <!-- GIẢNG VIÊN -->
                    <a asp-controller="GiangVien"
                       asp-action="Index"
                       class="sidebar-link @Active("GiangVien")">
                        <i class="fa-solid fa-user-tie"></i>
                        <span>Giảng viên</span>
                    </a>

                    <!-- ĐỀ TÀI -->
                    <a asp-controller="DeTai"
                       asp-action="Index"
                       class="sidebar-link @Active("DeTai")">
                        <i class="fa-solid fa-book-open"></i>
                        <span>Đề tài</span>
                    </a>

                    <!-- SINH VIÊN -->
                    <a asp-controller="SinhVien"
                       asp-action="Index"
                       class="sidebar-link @Active("SinhVien")">
                        <i class="fa-solid fa-user-graduate"></i>
                        <span>Sinh viên</span>
                    </a>

                    <div class="sidebar-group-title">
                        QUẢN LÝ NGHIỆP VỤ
                    </div>

                    <!-- CẤU HÌNH ĐỢT ĐĂNG KÝ -->
                    <a asp-controller="DotDangKy"
                       asp-action="Index"
                       class="sidebar-link @Active("DotDangKy")">
                        <i class="fa-solid fa-calendar-check"></i>
                        <span>Cấu hình đợt đăng ký</span>
                    </a>

                    <!-- DUYỆT ĐĂNG KÝ -->
                    <a asp-controller="DuyetDangKy"
                       asp-action="Index"
                       class="sidebar-link @Active("DuyetDangKy")">
                        <i class="fa-solid fa-clipboard-check"></i>
                        <span>Duyệt đăng ký</span>
                    </a>

                    <!-- PHÂN CÔNG GIẢNG VIÊN -->
                    <a asp-controller="PhanCong"
                       asp-action="Index"
                       class="sidebar-link @Active("PhanCong")">
                        <i class="fa-solid fa-user-check"></i>
                        <span>Phân công giảng viên</span>
                    </a>

                    <div class="sidebar-group-title">
                        BÁO CÁO
                    </div>

                    <!-- THỐNG KÊ -->
                    <a asp-controller="ThongKe"
                       asp-action="Index"
                       class="sidebar-link @Active("ThongKe")">
                        <i class="fa-solid fa-chart-column"></i>
                        <span>Thống kê</span>
                    </a>
                }

            </nav>

            <div class="sidebar-footer">
                <i class="fa-solid fa-shield-halved me-2"></i>
                Hệ thống quản lý UNETI
            </div>

        </aside>
    }

    <!-- MAIN CONTENT -->
    <main class="uneti-main @(daDangNhap ? "" : "no-sidebar")">
        <div class="uneti-main-inner">
            @RenderBody()
        </div>
    </main>

    @await Html.PartialAsync("_ConfirmModal")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/confirm-modal.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
        const toggle = document.getElementById("sidebarToggle");
        const sidebar = document.getElementById("unetiSidebar");

        if (!toggle || !sidebar) return;

        toggle.addEventListener("click", function () {
        const opened = sidebar.classList.toggle("show");
        toggle.setAttribute("aria-expanded", String(opened));
        });

        document.addEventListener("click", function (event) {
        if (window.innerWidth > 991) return;

        if (!sidebar.contains(event.target) &&
        !toggle.contains(event.target)) {
        sidebar.classList.remove("show");
        toggle.setAttribute("aria-expanded", "false");
        }
        });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
