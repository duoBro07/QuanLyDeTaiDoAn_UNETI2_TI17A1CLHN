@* Màn 1 + 5: Danh sách sinh viên (Admin) và hộp thoại khóa/mở khóa *@
@model List<QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models.SinhVien>
@using QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models
@using QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.ViewModels
@{
    ViewData["Title"] = "Danh sách sinh viên";
    var pt = (PhanTrangVM)ViewBag.PhanTrang;
    int stt = (pt.Trang - 1) * 5;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">Danh sách sinh viên</h3>
    <a asp-action="Create" class="btn btn-primary">+ Thêm sinh viên</a>
</div>

<div class="m3-card">
    <form method="get" class="d-flex gap-2 mb-3">
        <input name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Tìm kiếm theo tên, mã sinh viên, email..." />
        <button class="btn btn-primary text-nowrap">Tìm kiếm</button>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info mb-0">Không tìm thấy sinh viên phù hợp.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>STT</th><th>Mã SV</th><th>Họ tên</th><th>Lớp</th><th>Email</th><th>Trạng thái</th><th>Thao tác</th></tr>
                </thead>
                <tbody>
                @foreach (var sv in Model)
                {
                    bool hoatDong = sv.TrangThai == TrangThaiSinhVien.HoatDong;
                    <tr>
                        <td>@(++stt)</td>
                        <td>@sv.MaSinhVien</td>
                        <td>@sv.HoTen</td>
                        <td>@sv.Lop</td>
                        <td>@sv.Email</td>
                        <td><span class="badge @UiHelper.Badge(sv.TrangThai)">@sv.TrangThai</span></td>
                        <td class="text-nowrap">
                            <a asp-action="Details" asp-route-id="@sv.MaSinhVien" class="btn btn-sm btn-outline-info">Chi tiết</a>
                            <a asp-action="Edit" asp-route-id="@sv.MaSinhVien" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <button type="button" class="btn btn-sm @(hoatDong ? "btn-outline-danger" : "btn-outline-success")"
                                    data-bs-toggle="modal" data-bs-target="#modalDoiTrangThai"
                                    data-url="@Url.Action("DoiTrangThai", new { id = sv.MaSinhVien })"
                                    data-ma="@sv.MaSinhVien" data-ten="@sv.HoTen" data-khoa="@(hoatDong ? "true" : "false")">
                                @(hoatDong ? "Khóa" : "Mở khóa")
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <partial name="_PhanTrang" model="pt" />
    }
</div>

<div class="modal fade" id="modalDoiTrangThai" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="formDoiTrangThai" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header"><h5 class="modal-title" id="mdTieuDe"></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body" id="mdNoiDung"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn" id="mdNut"></button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('modalDoiTrangThai').addEventListener('show.bs.modal', function (e) {
            var b = e.relatedTarget, khoa = b.dataset.khoa === 'true';
            document.getElementById('formDoiTrangThai').action = b.dataset.url;
            document.getElementById('mdTieuDe').textContent = khoa ? 'Khóa sinh viên' : 'Mở khóa sinh viên';
            document.getElementById('mdNoiDung').textContent =
                'Bạn có chắc chắn muốn ' + (khoa ? 'khóa' : 'mở khóa') + ' sinh viên ' + b.dataset.ten + ' (' + b.dataset.ma + ')?';
            var nut = document.getElementById('mdNut');
            nut.textContent = khoa ? 'Khóa' : 'Mở khóa';
            nut.className = 'btn ' + (khoa ? 'btn-danger' : 'btn-success');
        });
    </script>
}
