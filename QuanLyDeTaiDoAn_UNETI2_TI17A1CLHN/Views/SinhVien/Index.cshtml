@model IEnumerable<QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models.SinhVien>

@{
    ViewData["Title"] = "Quản lý sinh viên";

    int trang = ViewBag.Trang ?? 1;
    int tongTrang = ViewBag.TongTrang ?? 1;
    int tong = ViewBag.Tong ?? 0;
    int kichThuoc = 8;

    string tuKhoa = ViewBag.TuKhoa ?? "";
    string trangThai = ViewBag.TrangThai ?? "";

    int batDau = tong == 0 ? 0 : (trang - 1) * kichThuoc + 1;
    int ketThuc = Math.Min(trang * kichThuoc, tong);
}

<div class="content-card">
    <div class="p-3 p-lg-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h2 class="page-title mb-1">
                    <i class="fa-solid fa-user-graduate me-2"></i>
                    Quản lý sinh viên
                </h2>
                <p class="page-description mb-0">
                    Quản lý hồ sơ, tìm kiếm và trạng thái sinh viên
                </p>
            </div>

            <a asp-action="Create" class="btn btn-main">
                <i class="fa-solid fa-plus"></i>
                Thêm sinh viên
            </a>
        </div>

        @if (TempData["ThongBaoSinhVien"] != null)
        {
            <div class="alert alert-success">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["ThongBaoSinhVien"]
            </div>
        }

        <form asp-action="Index"
              method="get"
              class="uneti-filter-bar">

            <div class="row g-3">
                <div class="col-md-6">
                    <label for="tuKhoa" class="form-label">
                        Tìm kiếm
                    </label>
                    <input id="tuKhoa"
                           name="tuKhoa"
                           value="@tuKhoa"
                           class="form-control"
                           placeholder="Họ tên, lớp, khoa, email..." />
                </div>

                <div class="col-md-3">
                    <label for="trangThai" class="form-label">
                        Trạng thái
                    </label>
                    <select id="trangThai"
                            name="trangThai"
                            class="form-select">
                        <option value="">Tất cả</option>
                        <option value="HoatDong"
                                selected="@(trangThai == "HoatDong")">
                            Hoạt động
                        </option>
                        <option value="DaKhoa"
                                selected="@(trangThai == "DaKhoa")">
                            Tạm ngừng
                        </option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-main flex-fill">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        Tìm kiếm
                    </button>
                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        <i class="fa-solid fa-rotate-left"></i>
                        Đặt lại
                    </a>
                </div>
            </div>
        </form>

        <h5 class="fw-bold mb-0" style="color:#17477e">
            <i class="fa-solid fa-list me-2"></i>
            Danh sách sinh viên (@tong)
        </h5>
    </div>

    <div class="table-responsive">
        <table class="table uneti-table table-hover mb-0">
            <thead>
                <tr>
                    <th class="ps-3">STT</th>
                    <th>Mã SV</th>
                    <th>Họ tên</th>
                    <th>Ngày sinh</th>
                    <th>Lớp</th>
                    <th>Khoa</th>
                    <th>Chuyên ngành</th>
                    <th>Email</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    int stt = batDau;
                    foreach (var sv in Model)
                    {
                        <tr>
                            <td class="ps-3">@stt</td>
                            <td>@sv.MaSinhVien</td>
                            <td class="fw-semibold">@sv.HoTen</td>
                            <td>@sv.NgaySinh.ToString("dd/MM/yyyy")</td>
                            <td>@sv.Lop</td>
                            <td>@sv.Khoa</td>
                            <td>@sv.ChuyenNganh</td>
                            <td>@sv.Email</td>
                            <td class="text-center">
                                @if (sv.TrangThai)
                                {
                                    <span class="uneti-status uneti-status-success">
                                        Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="uneti-status uneti-status-danger">
                                        Tạm ngừng
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="uneti-actions">
                                    <a asp-action="Details"
                                       asp-route-id="@sv.MaSinhVien"
                                       class="btn btn-outline-primary btn-sm"
                                       title="Xem chi tiết">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@sv.MaSinhVien"
                                       class="btn btn-outline-primary btn-sm"
                                       title="Chỉnh sửa">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>

                                    <button type="button"
                                            class="btn @(sv.TrangThai ? "btn-outline-danger" : "btn-outline-primary") btn-sm"
                                            title="@(sv.TrangThai ? "Tạm ngừng" : "Kích hoạt")"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalTrangThai"
                                            data-id="@sv.MaSinhVien"
                                            data-name="@sv.HoTen"
                                            data-action="@(sv.TrangThai ? "tạm ngừng" : "kích hoạt")">
                                        <i class="fa-solid @(sv.TrangThai ? "fa-lock" : "fa-lock-open")"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        stt++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-5">
                            <i class="fa-solid fa-inbox fa-2x d-block mb-3"></i>
                            Không tìm thấy sinh viên phù hợp.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 p-3 border-top">
        <div class="uneti-pagination-info">
            Hiển thị <strong>@batDau - @ketThuc</strong>
            trong tổng số <strong>@tong</strong> sinh viên
        </div>

        @if (tongTrang > 1)
        {
            <nav aria-label="Phân trang sinh viên">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(trang <= 1 ? "disabled" : "")">
                        @if (trang > 1)
                        {
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-trang="@(trang - 1)"
                               asp-route-tuKhoa="@tuKhoa"
                               asp-route-trangThai="@trangThai">
                                Trước
                            </a>
                        }
                        else
                        {
                            <span class="page-link">Trước</span>
                        }
                    </li>

                    @for (int i = Math.Max(1, trang - 2);
                          i <= Math.Min(tongTrang, trang + 2);
                          i++)
                    {
                        <li class="page-item @(i == trang ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-trang="@i"
                               asp-route-tuKhoa="@tuKhoa"
                               asp-route-trangThai="@trangThai">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(trang >= tongTrang ? "disabled" : "")">
                        @if (trang < tongTrang)
                        {
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-trang="@(trang + 1)"
                               asp-route-tuKhoa="@tuKhoa"
                               asp-route-trangThai="@trangThai">
                                Sau
                            </a>
                        }
                        else
                        {
                            <span class="page-link">Sau</span>
                        }
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

<!-- XAC NHAN KHOA / MO KHOA -->

<div class="modal fade"
     id="modalTrangThai"
     tabindex="-1"
     aria-labelledby="tieuDeTrangThai"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tieuDeTrangThai">
                    <i class="fa-solid fa-circle-question me-2"></i>
                    Xác nhận thay đổi trạng thái
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                Bạn có chắc muốn
                <strong id="tenHanhDong"></strong>
                hồ sơ sinh viên
                <strong id="tenSinhVien"></strong>?

                <p class="text-muted small mt-2 mb-0">
                    Thao tác này không xóa dữ liệu sinh viên.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Hủy
                </button>

                <form asp-controller="SinhVien"
                      asp-action="DoiTrangThai"
                      method="post"
                      id="formTrangThai">
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="maSinhVienXacNhan"
                           name="id" />

                    <button type="submit" class="btn btn-main">
                        <i class="fa-solid fa-check"></i>
                        Xác nhận
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const modal = document.getElementById("modalTrangThai");
            if (!modal) return;

            modal.addEventListener("show.bs.modal", function (event) {
                const button = event.relatedTarget;
                if (!button) return;

                document.getElementById("maSinhVienXacNhan").value =
                    button.getAttribute("data-id");

                document.getElementById("tenSinhVien").textContent =
                    button.getAttribute("data-name");

                document.getElementById("tenHanhDong").textContent =
                    button.getAttribute("data-action");
            });
        });
    </script>
}
