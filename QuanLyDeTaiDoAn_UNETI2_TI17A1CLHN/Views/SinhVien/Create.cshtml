@model QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models.SinhVien

@{
    ViewData["Title"] = "Thêm sinh viên";
}

<div class="content-card">
    <div class="p-3 p-lg-4">
        <div class="mb-4">
            <h2 class="page-title mb-1">
                <i class="fa-solid fa-user-plus me-2"></i>
                Thêm sinh viên
            </h2>
            <p class="page-description mb-0">
                Nhập thông tin hồ sơ sinh viên
            </p>
        </div>

        <form asp-controller="SinhVien"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="MaTaiKhoan" class="form-label">
                        Tài khoản sinh viên
                        <span class="text-danger">*</span>
                    </label>
                    <select asp-for="MaTaiKhoan"
                            asp-items="ViewBag.DanhSachTaiKhoan"
                            class="form-select">
                        <option value="0">-- Chọn tài khoản sinh viên --</option>
                    </select>
                    <span asp-validation-for="MaTaiKhoan"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="HoTen" class="form-label">
                        Họ và tên <span class="text-danger">*</span>
                    </label>
                    <input asp-for="HoTen"
                           class="form-control"
                           placeholder="Nhập họ và tên" />
                    <span asp-validation-for="HoTen"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="NgaySinh" class="form-label">
                        Ngày sinh
                    </label>
                    <input asp-for="NgaySinh"
                           type="date"
                           class="form-control" />
                    <span asp-validation-for="NgaySinh"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Lop" class="form-label">
                        Lớp <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Lop"
                           class="form-control"
                           placeholder="Ví dụ: TI17A1CLHN" />
                    <span asp-validation-for="Lop"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Khoa" class="form-label">
                        Khoa <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Khoa"
                           class="form-control"
                           placeholder="Nhập tên khoa" />
                    <span asp-validation-for="Khoa"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ChuyenNganh" class="form-label">
                        Chuyên ngành <span class="text-danger">*</span>
                    </label>
                    <input asp-for="ChuyenNganh"
                           class="form-control"
                           placeholder="Nhập chuyên ngành" />
                    <span asp-validation-for="ChuyenNganh"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">
                        Email <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="example@uneti.edu.vn" />
                    <span asp-validation-for="Email"
                          class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="SoDienThoai" class="form-label">
                        Số điện thoại
                    </label>
                    <input asp-for="SoDienThoai"
                           type="tel"
                           class="form-control"
                           placeholder="Nhập số điện thoại" />
                    <span asp-validation-for="SoDienThoai"
                          class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label class="form-label d-block">Trạng thái</label>

                    <div class="form-check form-check-inline">
                        <input asp-for="TrangThai"
                               type="radio"
                               value="true"
                               id="createHoatDong"
                               class="form-check-input" />
                        <label for="createHoatDong"
                               class="form-check-label">
                            Hoạt động
                        </label>
                    </div>

                    <div class="form-check form-check-inline">
                        <input asp-for="TrangThai"
                               type="radio"
                               value="false"
                               id="createTamNgung"
                               class="form-check-input" />
                        <label for="createTamNgung"
                               class="form-check-label">
                            Tạm ngừng
                        </label>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2 flex-wrap">
                <a asp-controller="SinhVien"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left"></i>
                    Quay lại
                </a>

                <button type="submit" class="btn btn-main">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Lưu sinh viên
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
