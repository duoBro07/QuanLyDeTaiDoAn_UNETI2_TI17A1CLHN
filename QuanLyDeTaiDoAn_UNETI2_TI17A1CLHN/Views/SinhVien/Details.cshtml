@* Màn 4: Chi tiết sinh viên (Admin) *@
@model QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models.SinhVien
@using QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models
@{ ViewData["Title"] = "Chi tiết sinh viên"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">Thông tin sinh viên</h3>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-light border">Quay lại</a>
        <a asp-action="Edit" asp-route-id="@Model.MaSinhVien" class="btn btn-primary">Chỉnh sửa</a>
    </div>
</div>
<div class="m3-card">
    <div class="d-flex gap-4 align-items-start">
        <div class="m3-avatar">@(Model.HoTen.Length > 0 ? Model.HoTen.Trim().Split(' ').Last()[0].ToString() : "?")</div>
        <dl class="row mb-0 flex-grow-1">
            <dt class="col-sm-3">Mã SV</dt><dd class="col-sm-9">@Model.MaSinhVien</dd>
            <dt class="col-sm-3">Họ tên</dt><dd class="col-sm-9">@Model.HoTen</dd>
            <dt class="col-sm-3">Ngày sinh</dt><dd class="col-sm-9">@Model.NgaySinh?.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Giới tính</dt><dd class="col-sm-9">@Model.GioiTinh</dd>
            <dt class="col-sm-3">Lớp</dt><dd class="col-sm-9">@Model.Lop</dd>
            <dt class="col-sm-3">Khoa</dt><dd class="col-sm-9">@Model.Khoa</dd>
            <dt class="col-sm-3">Chuyên ngành</dt><dd class="col-sm-9">@(Model.ChuyenNganh ?? "—")</dd>
            <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Số điện thoại</dt><dd class="col-sm-9">@(Model.SoDienThoai ?? "—")</dd>
            <dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9"><span class="badge @UiHelper.Badge(Model.TrangThai)">@Model.TrangThai</span></dd>
        </dl>
    </div>
</div>
