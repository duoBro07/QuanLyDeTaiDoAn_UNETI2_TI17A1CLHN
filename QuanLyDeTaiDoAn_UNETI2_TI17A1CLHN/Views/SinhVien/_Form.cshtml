
@model QuanLyDeTaiDoAn_UNETI2_TI17A1CLHN.Models.SinhVien
@{
    bool sua = ViewContext.RouteData.Values["action"]?.ToString() == "Edit";
}
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="MaSinhVien" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="MaSinhVien" class="form-control" placeholder="Nhập mã sinh viên" readonly="@sua" />
        <span asp-validation-for="MaSinhVien" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="HoTen" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="HoTen" class="form-control" placeholder="Nhập họ tên" />
        <span asp-validation-for="HoTen" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="NgaySinh" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="NgaySinh" type="date" class="form-control" />
        <span asp-validation-for="NgaySinh" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="GioiTinh" class="form-label"></label> <span class="text-danger">*</span>
        <div class="pt-2">
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="GioiTinh" value="Nam" id="gtNam" />
                <label class="form-check-label" for="gtNam">Nam</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="GioiTinh" value="Nữ" id="gtNu" />
                <label class="form-check-label" for="gtNu">Nữ</label>
            </div>
        </div>
        <span asp-validation-for="GioiTinh" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Lop" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="Lop" class="form-control" placeholder="Ví dụ TI17A1HN" />
        <span asp-validation-for="Lop" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Khoa" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="Khoa" class="form-control" placeholder="Ví dụ Công nghệ thông tin" />
        <span asp-validation-for="Khoa" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ChuyenNganh" class="form-label"></label>
        <input asp-for="ChuyenNganh" class="form-control" placeholder="Nhập chuyên ngành" />
        <span asp-validation-for="ChuyenNganh" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label> <span class="text-danger">*</span>
        <input asp-for="Email" class="form-control" placeholder="Nhập email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="SoDienThoai" class="form-label"></label>
        <input asp-for="SoDienThoai" class="form-control" placeholder="Nhập số điện thoại" />
        <span asp-validation-for="SoDienThoai" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="TrangThai" class="form-label"></label>
        <select asp-for="TrangThai" class="form-select">
            <option value="Hoạt động">Hoạt động</option>
            <option value="Khóa">Khóa</option>
        </select>
    </div>
</div>
<div class="mt-4 d-flex gap-2 justify-content-end">
    <a asp-action="Index" class="btn btn-light border">Hủy</a>
    <button type="submit" class="btn btn-primary">Lưu</button>
</div>
